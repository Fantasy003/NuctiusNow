@page "/just-for-you"
@rendermode InteractiveServer
@using NuctiusNow.Services
@using NuctiusNow.Client
@inject UserSessionService sessionService
@inject RecommendationEngine recommendationEngine
@inject NavigationManager Navigation

<PageTitle>Just For You - NuctiusNow</PageTitle>

<div class="jfy-page-container">

    <div class="jfy-wrapper">

        <div class="jfy-grid">
            @for (int i = 0; i < Math.Min(4, NoticiasPersonalizadas.Count); i++)
            {
                var noticia = NoticiasPersonalizadas[i];

                <NavLink href="@($"noticia-detalle/{noticia.Id}")" class="news-box-link">
                    <div class="news-box">
                        <span class="category-tag">@noticia.Categoria</span>
                        <h2 class="news-title">@noticia.Titulo</h2>

                        <div class="news-content-flex">
                            <div class="news-text-side">
                                <span class="summary-label">NEWS SUMMARY</span>
                                <p class="news-body">@noticia.Contenido</p>
                            </div>

                            <div class="news-image-side">
                                <img src="@noticia.UrlImagen" alt="News Image" />
                            </div>
                        </div>
                    </div>
                </NavLink>
            }
        </div>

        <div class="center-refresh-zone">
            <button class="btn-refresh" @onclick="RefreshFeed">
                <span class="refresh-text-top">Refresh</span>
                <div class="refresh-icon-circle">
                    <svg viewBox="0 0 24 24" class="sync-icon">
                        <path d="M19 8l-4 4h3c0 3.31-2.69 6-6 6a5.87 5.87 0 0 1-2.8-.7l-1.46 1.46A7.93 7.93 0 0 0 12 20c4.42 0 8-3.58 8-8h3l-4-4zM6 12c0-3.31 2.69-6 6-6 1.01 0 1.97.25 2.8.7l1.46-1.46A7.93 7.93 0 0 0 12 4c-4.42 0-8 3.58-8 8H1l4 4 4-4H6z" />
                    </svg>
                </div>
                <span class="refresh-text-bottom">News</span>
            </button>
        </div>

    </div>

    <div class="floating-menu-container">
        <div class="floating-menu-card">

            <div class="menu-content">
                <div class="menu-actions">
                    <NavLink href=""><button class="menu-btn">Home</button></NavLink>
                    <NavLink href="just-for-you"><button class="menu-btn menu-btn-active">Just for you</button></NavLink>
                    <NavLink href="user-settings"><button class="menu-btn">User settings</button></NavLink>
                    <button class="menu-btn">Help</button>
                </div>

                <div class="premium-box">
                    <h4>Premium Status</h4>
                    @if (isPremium && isUserLoggedIn)
                    {
                        <div class="status-badge active">🟢 Activo</div>
                    }
                    else
                    {
                        <div class="status-badge inactive">🔴 Inactivo</div>
                    }
                </div>
            </div>

            <div class="menu-tab">
                <span>NuctiusNow</span>
            </div>
        </div>
    </div>

</div>

@if (showDiagnostics)
{
    <div class="diagnostic-panel">
        <h3>Diagnostics</h3>
        <div class="diagnostic-entries">
            @if (diagnostics.Count == 0)
            {
                <div>No diagnostic messages yet.</div>
            }
            else
            {
                <ul>
                    @foreach (var d in diagnostics)
                    {
                        <li>@d</li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private bool isUserLoggedIn = true;
    private bool isPremium = true;
    private List<JfyItem> NoticiasPersonalizadas = new();
    private List<string> diagnostics = new();
    private bool showDiagnostics = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            diagnostics.Add($"OnAfterRenderAsync: initializing session at {DateTime.UtcNow}");
            await sessionService.InitializeAsync();
            diagnostics.Add($"Session initialized. IsAuthenticated={sessionService.IsAuthenticated}");
        }
        catch (Exception ex)
        {
            diagnostics.Add($"Exception during session initialize: {ex.Message}");
        }

        if (!sessionService.IsAuthenticated)
        {
            diagnostics.Add("User not authenticated - navigating to login");
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadRecommendationsAsync();
    }

    private void RefreshFeed()
    {
        var random = new Random();
        NoticiasPersonalizadas = NoticiasPersonalizadas.OrderBy(_ => random.Next()).ToList();
        StateHasChanged();
    }

    private async Task LoadRecommendationsAsync()
    {
        NoticiasPersonalizadas = new List<JfyItem>();
        diagnostics.Add($"LoadRecommendationsAsync: start at {DateTime.UtcNow}");

        if (sessionService.UserId == null)
        {
            diagnostics.Add("User ID is null - no recommendations loaded.");
            StateHasChanged();
            return;
        }

        try
        {
            // 1. Fetch preferences from SQL using the assumed method signature
        List<string> allPreferences = await recommendationEngine.GetUserPreferencesAsync(sessionService.UserId.Value);

            if (allPreferences == null || !allPreferences.Any())
            {
                diagnostics.Add("No user preferences found in the database.");
                NoticiasPersonalizadas = new List<JfyItem>();
                StateHasChanged();
                return;
            }

            // 2. Select exactly 4 random preferences (or fewer if less than 4 are available)
            var random = new Random();
            var selectedPrefs = allPreferences.OrderBy(x => random.Next()).Take(4).ToList();

            var items = new List<JfyItem>();
            int idCounter = 1;

            // 3. Loop through preferences, prompt the AI, and create the news item
            foreach (var pref in selectedPrefs)
            {
                diagnostics.Add($"Prompting AI for preference: {pref}");

                // Build the specific prompt for the AI
                string prompt = $"Write a brief, current news summary about: {pref}";

                // Call your LLM to get the summary based on the prompt
                var aiSummary = await recommendationEngine.SummarizeAsync(prompt);

                items.Add(new JfyItem
                {
                    Id = idCounter++,
                    Categoria = pref, // Use the preference as the category tag
                    Titulo = $"Latest Updates: {pref}",
                    Contenido = !string.IsNullOrWhiteSpace(aiSummary) ? aiSummary : "Summary unavailable.",
                    UrlImagen = $"https://picsum.photos/seed/{pref.Replace(" ", "")}/150/150" // Consistent random image per topic
                });
            }

            NoticiasPersonalizadas = items;
        }
        catch (Exception ex)
        {
            diagnostics.Add($"LoadRecommendationsAsync exception: {ex.Message}");
            // ensure UI shows something and keep app running
            NoticiasPersonalizadas = new List<JfyItem>();
        }

        diagnostics.Add($"Finished at {DateTime.UtcNow} - items={NoticiasPersonalizadas.Count}");
        StateHasChanged();
    }

    private void ToggleDiagnostics()
    {
        showDiagnostics = !showDiagnostics;
    }

    private async Task AiSearchNow()
    {
        diagnostics.Add($"AI Search started at {DateTime.UtcNow}");
        if (sessionService.UserId == null)
        {
            diagnostics.Add("AI Search: user not authenticated");
            return;
        }

        try
        {
            var ingested = await recommendationEngine.ExecuteNewsSearchWorkflowAsync(sessionService.UserId.Value, numSearches: 4);
            diagnostics.Add($"AI Search: complete - ingested {ingested.Count} URLs");
            foreach (var u in ingested) diagnostics.Add($"✓ Ingested: {u}");
        }
        catch (Exception ex)
        {
            diagnostics.Add($"AI Search error: {ex.Message}");
        }

        await LoadRecommendationsAsync();
    }

    public string GetRandomString(int min, int max)
    {
        var random = new Random();
        return random.Next(min, max + 1).ToString("D3");
    }

    public class JfyItem
    {
        public int Id { get; set; }
        public string Categoria { get; set; } = "";
        public string Titulo { get; set; } = "";
        public string Contenido { get; set; } = "";
        public string UrlImagen { get; set; } = "";
    }
}