@page "/just-for-you"

@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related
@inject UserSessionService sessionService
@inject RecommendationEngine recommendationEngine
@inject NavigationManager Navigation

<PageTitle>Just For You - NuctiusNow</PageTitle>

<div class="jfy-page-container">

    <div class="jfy-wrapper">

        <div class="jfy-grid">
            @if (errorMessage != null)
            {
                <div style="text-align:center; padding:2rem; color:#d9534f;">
                    <p>@errorMessage</p>
                    <button class="btn-refresh" @onclick="LoadRecommendationsAsync">Retry</button>
                </div>
            }
            else if (PersonalizedNews == null)
            {
                <div style="display:flex; justify-content:center; align-items:center; padding:4rem;">
                    <div class="loading-spinner"></div>
                </div>
            }
            else if (PersonalizedNews.Count == 0)
            {
                <div style="text-align:center; padding:2rem; color:var(--text-muted);">
                    <p>No personalized news available. Press the refresh button to search with AI.</p>
                </div>
            }
            else
            {
                @for (int i = 0; i < PersonalizedNews.Count; i++)
                {
                    var news = PersonalizedNews[i];
                    var summary = news.DetailNews?.AiSummary
                        ?? recommendationEngine.Summarize(news.DetailNews, 220);

                    <a href="@($"/news-detail/{news.IdNews}")" class="news-box-link jfy-text-card">
                        <div class="news-box jfy-text-only">
                            <span class="category-tag-inline">@(news.Tag?.Name ?? "General")</span>
                            <h2 class="news-title">@(news.DetailNews?.Keyword ?? "No Title")</h2>
                            <p class="news-body">@summary</p>
                        </div>
                    </a>
                }
            }

            <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
                <a href="/" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                    <span>Home</span>
                </a>
                <a href="/just-for-you" class="bottom-nav-item active">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
                    <span>For You</span>
                </a>
                <a href="/search" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5S8.01 5 10.5 5 15 7.01 15 9.5 12.99 14 10.5 14z" /></svg>
                    <span>Search</span>
                </a>
                <a href="/user-settings" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                    <span>Settings</span>
                </a>
            </nav>
        </div>
        
        <div class="center-refresh-zone">
            <button class="btn-refresh" @onclick="AiSearchNow" disabled="@isSearching">
                <span class="refresh-icon-circle">
                    <svg class="sync-icon" viewBox="0 0 24 24"><path d="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46C19.54 15.03 20 13.57 20 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74C4.46 8.97 4 10.43 4 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/></svg>
                </span>
            </button>
        </div>
    </div>
</div>

@code {
    private List<News>? PersonalizedNews;
    private bool isSearching;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await InitializePageAsync();
    }

    private async Task InitializePageAsync()
    {
        try
        {
            await sessionService.InitializeAsync();

            if (!sessionService.IsAuthenticated)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            await LoadRecommendationsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error initializing Just For You page: {ex}");
            errorMessage = "Could not load personalized news.";
        }
    }

    private async Task LoadRecommendationsAsync()
    {
        errorMessage = null;

        if (sessionService.UserId == null)
        {
            PersonalizedNews = new List<News>();
            return;
        }

        try
        {
            var userId = sessionService.UserId.Value;
            var recommendations = await recommendationEngine.GetPersonalizedNewsOnePerPreferenceAsync(userId);
            PersonalizedNews = recommendations?.ToList() ?? new List<News>();

            Console.WriteLine($"Personalized news loaded: {PersonalizedNews.Count}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error loading personalized news: {ex}");
            PersonalizedNews = null;
            errorMessage = "An error occurred while loading news. Check the logs.";
        }
    }

    private async Task AiSearchNow()
    {
        if (isSearching || sessionService.UserId == null) return;

        isSearching = true;
        errorMessage = null;

        try
        {
            var userId = sessionService.UserId.Value;
            Console.WriteLine($"Starting AI news search for user {userId}");

            await recommendationEngine.ExecuteNewsSearchWorkflowAsync(userId, numSearches: 6);
            Console.WriteLine("AI news search workflow completed.");

            await LoadRecommendationsAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Error executing AI news search: {ex}");
            errorMessage = "The AI encountered an error while searching or saving news.";
        }
        finally
        {
            isSearching = false;
            await InvokeAsync(StateHasChanged);
        }
    }
}