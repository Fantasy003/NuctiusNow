@page "/just-for-you"

@using System.Collections.Concurrent
@using Microsoft.EntityFrameworkCore
@using NuctiusNow.Data
@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related

@inject UserSessionService sessionService
@inject RecommendationEngine RecommendationEngine
@inject CategoryNewsService CategoryNewsService
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject NavigationManager Navigation

<PageTitle>NuctiusNow - Just For You</PageTitle>

<div class="jfy-page-container">
    <div class="jfy-wrapper">
        @if (!_isInitialized)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Loading your feed…</h1>
                <p>We are preparing recommendations from your preferences and recent interactions.</p>
            </section>
        }
        else if (!sessionService.IsAuthenticated)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Sign in to personalize your feed</h1>
                <p>Log in to let the recommendation engine learn from the topics you follow and the stories you interact with.</p>
                <button class="jfy-primary-button" type="button" @onclick='() => Navigation.NavigateTo("/login")'>
                    Log in
                </button>
            </section>
        }
        else if (Categories.Count == 0)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Your feed needs a few interests</h1>
                <p>Select some topics in your profile and NuctiusNow will start searching for matching stories.</p>
                <button class="jfy-primary-button" type="button" @onclick='() => Navigation.NavigateTo("/user-settings")'>
                    Update preferences
                </button>
            </section>
        }
        else
        {
            <header class="jfy-header">
                <div>
                    <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                    <h1 class="jfy-heading">Just For You</h1>
                    <p class="jfy-subheading">
                        Fresh stories searched from the web using your preferences and the signals you create while browsing.
                    </p>
                </div>

                <div class="jfy-header-actions">
                    <span class="jfy-updated">
                        @if (_lastRefreshAt.HasValue)
                        {
                            <span>Updated @_lastRefreshAt.Value.ToLocalTime().ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span>Preparing feed</span>
                        }
                    </span>

                    <button class="jfy-refresh-button"
                            type="button"
                            disabled="@_isRefreshing"
                            @onclick="RefreshRecommendationsAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="jfy-refresh-icon">
                            <path d="M17.65 6.35A7.95 7.95 0 0012 4V1L7 6l5 5V8a4 4 0 11-4 4H6a6 6 0 106-6 5.98 5.98 0 014.24 1.76l1.41-1.41z" />
                        </svg>
                        <span>@(_isRefreshing ? "Searching…" : "Refresh feed")</span>
                    </button>
                </div>
            </header>

            <div class="jfy-context-strip">
                <div class="jfy-context-copy">
                    <span class="context-label">CURRENT SIGNALS</span>
                    <span class="context-text">Preferences + clicks + likes + comments + reading time</span>
                </div>
                <span class="context-dot"></span>
                <span class="context-status">AI ACTIVE</span>
            </div>

            <main class="jfy-grid" aria-label="Personalized news feed">
                @foreach (var cat in Categories)
                {
                    var isLoading = _isLoading.GetValueOrDefault(cat.Name, false);
                    var hottestNews = _hottestNewsByCategory.GetValueOrDefault(cat.Name);
                    var hasImage = HasNewsImage(hottestNews);

                    <button class="news-box-link @GetCategoryToneClass(cat.Name)"
                            type="button"
                            disabled="@(isLoading || hottestNews == null)"
                            @onclick="async () => await OpenCategoryNews(cat.Name, hottestNews)">
                        <article class="news-box">
                            <div class="card-media">
                                @if (hasImage && hottestNews != null)
                                {
                                    <img class="news-overview-image"
                                         src="@hottestNews.DetailNews!.ImageUrl"
                                         alt="@(hottestNews.DetailNews?.Keyword ?? cat.Name)"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="news-image-placeholder" aria-hidden="true">
                                        <span>@GetCategoryInitial(cat.Name)</span>
                                    </div>
                                }

                                <div class="card-media-shade"></div>
                                <span class="category-tag">@cat.Name</span>
                                <span class="category-rank">@cat.Rank.ToString("00")</span>
                            </div>

                            <div class="card-body">
                                <div class="card-topline">
                                    <span class="ai-badge">@GetSourceLabel(_sourceByCategory.GetValueOrDefault(cat.Name, NewsSelectionSource.None))</span>
                                    <span class="category-weight">Preference @cat.Weight</span>
                                </div>

                                @if (isLoading)
                                {
                                    <h2 class="news-title">Searching for a fresh story…</h2>
                                    <p class="news-body">The recommendation engine is checking new articles for this topic.</p>
                                }
                                else if (hottestNews != null)
                                {
                                    <h2 class="news-title">@(hottestNews.DetailNews?.Keyword ?? "Untitled story")</h2>
                                    <p class="news-body">
                                        @(hottestNews.DetailNews?.AiSummary
                                            ?? hottestNews.DetailNews?.Context
                                            ?? "No summary available.")
                                    </p>

                                    <div class="news-meta-row">
                                        <span class="news-meta">
                                            @((hottestNews.DetailNews?.NewsDate ?? hottestNews.CapturedDate).ToLocalTime().ToString("dd MMM yyyy"))
                                        </span>
                                        <span class="read-story">Open story <span aria-hidden="true">→</span></span>
                                    </div>
                                }
                                else
                                {
                                    <h2 class="news-title">No story found</h2>
                                    <p class="news-body">The AI and database fallbacks could not find a usable article for this topic.</p>
                                }
                            </div>
                        </article>
                    </button>
                }
            </main>
        }
    </div>

    <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
        <a href="/" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
            <span>Home</span>
        </a>
        <a href="/just-for-you" class="bottom-nav-item active">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
            <span>For You</span>
        </a>
        <a href="/search" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5S8.01 5 10.5 5 15 7.01 15 9.5 12.99 14 10.5 14z" /></svg>
            <span>Search</span>
        </a>
        <a href="/user-settings" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
            <span>Settings</span>
        </a>
    </nav>
</div>

@code {
    private bool _isInitialized;
    private bool _initialRefreshStarted;
    private bool _isRefreshing;
    private DateTimeOffset? _lastRefreshAt;

    private List<Category> Categories { get; set; } = new();
    private readonly ConcurrentDictionary<string, bool> _isLoading = new();
    private readonly ConcurrentDictionary<string, News?> _hottestNewsByCategory = new();
    private readonly ConcurrentDictionary<string, NewsSelectionSource> _sourceByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await sessionService.InitializeAsync();

        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            var userId = sessionService.UserId.Value;

            await using var db = await DbFactory.CreateDbContextAsync();
            var preferredCategories = await db.UserPreferences
                .Where(up => up.IdUser == userId && up.Preference != null && up.Preference.Tag != null)
                .Select(up => new
                {
                    Name = up.Preference!.Tag!.Name,
                    Weight = up.Preference.Weight
                })
                .ToListAsync();

            preferredCategories = preferredCategories
                .GroupBy(x => x.Name)
                .Select(g => new
                {
                    Name = g.Key,
                    Weight = g.Max(x => x.Weight)
                })
                .OrderByDescending(x => x.Weight)
                .ThenBy(x => x.Name)
                .ToList();

            Categories = preferredCategories
                .Select((item, index) => new Category(
                    item.Name,
                    item.Weight,
                    index + 1))
                .ToList();

            foreach (var category in Categories)
            {
                _isLoading[category.Name] = true;
                _hottestNewsByCategory[category.Name] = null;
                _sourceByCategory[category.Name] = NewsSelectionSource.None;
            }
        }

        _isInitialized = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _initialRefreshStarted || !sessionService.IsAuthenticated || Categories.Count == 0)
            return;

        _initialRefreshStarted = true;
        await RefreshRecommendationsAsync();
    }

    private async Task RefreshRecommendationsAsync()
    {
        if (!sessionService.IsAuthenticated || !sessionService.UserId.HasValue || Categories.Count == 0 || _isRefreshing)
            return;

        _isRefreshing = true;
        foreach (var category in Categories)
            _isLoading[category.Name] = true;

        await InvokeAsync(StateHasChanged);

        try
        {
            var userId = sessionService.UserId.Value;

            // Sequential execution avoids overloading the local LLM server with
            // several expensive article-extraction requests at the same time.
            foreach (var category in Categories)
            {
                await LoadCategoryNewsAsync(category, userId);
            }

            _lastRefreshAt = DateTimeOffset.UtcNow;
        }
        finally
        {
            _isRefreshing = false;
            foreach (var category in Categories)
                _isLoading[category.Name] = false;

            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadCategoryNewsAsync(Category category, int userId)
    {
        try
        {
            using var timeoutCts = new CancellationTokenSource(TimeSpan.FromMinutes(3));

            // JFY intentionally asks the AI first on every page entry/refresh.
            // If that search cannot produce a new article, CategoryNewsService
            // falls back to unseen/old/random database articles.
            var result = await CategoryNewsService.GetNewsForCategoryAsync(
                category.Name,
                userId,
                timeoutCts.Token,
                forceAiSearchFirst: true);

            _hottestNewsByCategory[category.Name] = result.News;
            _sourceByCategory[category.Name] = result.Source;

            if (result.News != null)
            {
                var imageUrl = await RecommendationEngine.EnsureNewsImageAsync(
                    result.News.IdNews,
                    CancellationToken.None);

                if (!string.IsNullOrWhiteSpace(imageUrl) && result.News.DetailNews != null)
                    result.News.DetailNews.ImageUrl = imageUrl;
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Unexpected error refreshing {category.Name}: {ex}");
            _hottestNewsByCategory[category.Name] = null;
            _sourceByCategory[category.Name] = NewsSelectionSource.None;
        }
        finally
        {
            _isLoading[category.Name] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenCategoryNews(string category, News? news)
    {
        if (news == null || news.IdNews <= 0) return;

        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            var userId = sessionService.UserId.Value;
            await RecommendationEngine.RegisterCategoryClickAsync(userId, news.IdNews);
            await CategoryNewsService.RegisterNewsViewAsync(userId, news.IdNews);
        }

        Navigation.NavigateTo($"/news-detail/{news.IdNews}");
    }

    private static bool HasNewsImage(News? news) =>
        !string.IsNullOrWhiteSpace(news?.DetailNews?.ImageUrl);

    private static string GetCategoryInitial(string category) =>
        string.IsNullOrWhiteSpace(category) ? "N" : category.Trim()[0].ToString().ToUpperInvariant();

    private static string GetCategoryToneClass(string category)
    {
        var value = (int)(uint)category.GetHashCode() % 5;
        return $"tone-{value + 1}";
    }

    private static string GetSourceLabel(NewsSelectionSource source) => source switch
    {
        NewsSelectionSource.AiSearch => "AI FRESH",
        NewsSelectionSource.DatabaseRecentUnseen => "NEW TO YOU",
        NewsSelectionSource.DatabaseOldUnseen => "UNSEEN ARCHIVE",
        NewsSelectionSource.DatabaseRandomFallback => "ARCHIVE FALLBACK",
        _ => "WAITING"
    };

    public record Category(string Name, int Weight, int Rank);
}