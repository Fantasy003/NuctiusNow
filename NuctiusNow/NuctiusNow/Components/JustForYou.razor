@page "/just-for-you"
@rendermode InteractiveServer
@using NuctiusNow.Services
@using NuctiusNow.Client
@inject UserSessionService sessionService
@inject RecommendationEngine recommendationEngine
@inject NavigationManager Navigation

<PageTitle>Just For You - NuctiusNow</PageTitle>

<div class="jfy-page-container">

    <div class="jfy-wrapper">

        <div class="jfy-grid">
            @for (int i = 0; i < Math.Min(4, PersonalizedNews.Count); i++)
            {
                var news = PersonalizedNews[i];

                <div class="news-box-link">
                    <div class="news-box">
                        <div class="card-media" style="background-image: url('@news.ImageUrl');">
                            <span class="category-tag">@news.Category</span>

                            <div class="action-column">
                                <button class="action-btn" title="Like">❤</button>
                                <button class="action-btn" title="Comment">💬</button>
                                <button class="action-btn" title="Share">⤴</button>
                            </div>
                        </div>

                        <div class="card-body">
                            <h2 class="news-title">@news.Title</h2>
                            <p class="news-body">@news.Content</p>
                        </div>
                    </div>
                </div>
            }

            <!-- Mobile bottom navigation -->
            <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
                <a href="/" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                    <span>Home</span>
                </a>
                <a href="/just-for-you" class="bottom-nav-item active">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
                    <span>For You</span>
                </a>
                <a href="/search" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5S8.01 5 10.5 5 15 7.01 15 9.5 12.99 14 10.5 14z" /></svg>
                    <span>Search</span>
                </a>
                <a href="/user-settings" class="bottom-nav-item">
                    <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                    <span>Settings</span>
                </a>
            </nav>
        </div>
    </div>
</div>

@if (showDiagnostics)
{
    <div class="diagnostic-panel">
        <h3>Diagnostics</h3>
        <div class="diagnostic-entries">
            @if (diagnostics.Count == 0)
            {
                <div>No diagnostic messages yet.</div>
            }
            else
            {
                <ul>
                    @foreach (var d in diagnostics)
                    {
                        <li>@d</li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    private bool isUserLoggedIn = true;
    private bool isPremium = true;
    private List<NewsItem> PersonalizedNews = new();
    private List<string> diagnostics = new();
    private bool showDiagnostics = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            diagnostics.Add($"OnAfterRenderAsync: initializing session at {DateTime.UtcNow}");
            await sessionService.InitializeAsync();
            diagnostics.Add($"Session initialized. IsAuthenticated={sessionService.IsAuthenticated}");
        }
        catch (Exception ex)
        {
            diagnostics.Add($"Exception during session initialize: {ex.Message}");
        }

        if (!sessionService.IsAuthenticated)
        {
            diagnostics.Add("User not authenticated - navigating to login");
            Navigation.NavigateTo("/login", true);
            return;
        }

        await LoadRecommendationsAsync();
    }

    private void RefreshFeed()
    {
        var random = new Random();
        PersonalizedNews = PersonalizedNews.OrderBy(_ => random.Next()).ToList();
        StateHasChanged();
    }

    private async Task LoadRecommendationsAsync()
    {
        PersonalizedNews = new List<NewsItem>();
        diagnostics.Add($"LoadRecommendationsAsync: start at {DateTime.UtcNow}");

        if (sessionService.UserId == null)
        {
            diagnostics.Add("User ID is null - no recommendations loaded.");
            StateHasChanged();
            return;
        }

        try
        {
            // 1. Fetch preferences from SQL using the assumed method signature
            List<string> allPreferences = await recommendationEngine.GetUserPreferencesAsync(sessionService.UserId.Value);

            if (allPreferences == null || !allPreferences.Any())
            {
                diagnostics.Add("No user preferences found in the database.");
                PersonalizedNews = new List<NewsItem>();
                StateHasChanged();
                return;
            }

            // 2. Select exactly 4 random preferences (or fewer if less than 4 are available)
            var random = new Random();
            var selectedPrefs = allPreferences.OrderBy(x => random.Next()).Take(4).ToList();

            var items = new List<NewsItem>();
            int idCounter = 1;

            // 3. Loop through preferences, prompt the AI, and create the news item
            foreach (var pref in selectedPrefs)
            {
                diagnostics.Add($"Prompting AI for preference: {pref}");

                // Build the specific prompt for the AI
                string prompt = $"Write a brief, current news summary about: {pref}";

                // Call your LLM to get the summary based on the prompt
                var aiSummary = await recommendationEngine.SummarizeAsync(prompt);

                items.Add(new NewsItem
                {
                    Id = idCounter++,
                    Category = pref, // Use the preference as the category tag
                    Title = $"Latest Updates: {pref}",
                    Content = !string.IsNullOrWhiteSpace(aiSummary) ? aiSummary : "Summary unavailable.",
                    ImageUrl = $"https://picsum.photos/seed/{pref.Replace(" ", "")}/150/150" // Consistent random image per topic
                });
            }

            PersonalizedNews = items;
        }
        catch (Exception ex)
        {
            diagnostics.Add($"LoadRecommendationsAsync exception: {ex.Message}");
            // ensure UI shows something and keep app running
            PersonalizedNews = new List<NewsItem>();
        }

        diagnostics.Add($"Finished at {DateTime.UtcNow} - items={PersonalizedNews.Count}");
        StateHasChanged();
    }

    private void ToggleDiagnostics()
    {
        showDiagnostics = !showDiagnostics;
    }

    private async Task AiSearchNow()
    {
        diagnostics.Add($"AI Search started at {DateTime.UtcNow}");
        if (sessionService.UserId == null)
        {
            diagnostics.Add("AI Search: user not authenticated");
            return;
        }

        try
        {
            var ingested = await recommendationEngine.ExecuteNewsSearchWorkflowAsync(sessionService.UserId.Value, numSearches: 4);
            diagnostics.Add($"AI Search: complete - ingested {ingested.Count} URLs");
            foreach (var u in ingested) diagnostics.Add($"✓ Ingested: {u}");
        }
        catch (Exception ex)
        {
            diagnostics.Add($"AI Search error: {ex.Message}");
        }

        await LoadRecommendationsAsync();
    }

    public string GetRandomString(int min, int max)
    {
        var random = new Random();
        return random.Next(min, max + 1).ToString("D3");
    }

    public class NewsItem
    {
        public int Id { get; set; }
        public string Category { get; set; } = "";
        public string Title { get; set; } = "";
        public string Content { get; set; } = "";
        public string ImageUrl { get; set; } = "";
    }
}
}