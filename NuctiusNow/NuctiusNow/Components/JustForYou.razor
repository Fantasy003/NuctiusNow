@page "/just-for-you"

@using NuctiusNow.Components.User_Related
@using NuctiusNow.Services
@inject UserSessionService sessionService
@implements IDisposable
@inject IServiceScopeFactory ScopeFactory
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>NuctiusNow - Just For You</PageTitle>

<div class="jfy-page-container">
    <div class="jfy-wrapper">
        @if (!_isInitialized)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Loading your feed…</h1>
                <p>We are asking the AI to understand your preferences and the signals you have created across NuctiusNow.</p>
            </section>
        }
        else if (!sessionService.IsAuthenticated)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Sign in to personalize your feed</h1>
                <p>Log in to let the recommendation engine use your preferences, reading behavior, reactions and comments.</p>
                <button class="jfy-primary-button" type="button" @onclick='() => Navigation.NavigateTo("/login")'>
                    Log in
                </button>
            </section>
        }
        else if (_preferences.Count == 0)
        {
            <section class="jfy-state-card">
                <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                <h1>Your feed needs a few interests</h1>
                <p>Add at least one preference and NuctiusNow will search for stories around it.</p>
                <button class="jfy-primary-button" type="button" @onclick='() => Navigation.NavigateTo("/user-settings")'>
                    Update preferences
                </button>
            </section>
        }
        else
        {
            <header class="jfy-header">
                <div>
                    <span class="section-kicker">NUCTIUSNOW / FOR YOU</span>
                    <h1 class="jfy-heading">Just For You</h1>
                    <p class="jfy-subheading">
                        One web-searched story for each preference, selected after the AI considers your preferences and overall site interactions.
                    </p>
                </div>

                <div class="jfy-header-actions">
                    <span class="jfy-updated">
                        @if (_lastRefreshAt.HasValue)
                        {
                            <span>Updated @_lastRefreshAt.Value.ToLocalTime().ToString("HH:mm")</span>
                        }
                        else
                        {
                            <span>Preparing feed</span>
                        }
                    </span>

                    <button class="jfy-refresh-button"
                            type="button"
                            disabled="@_isRefreshing"
                            @onclick="RefreshRecommendationsAsync">
                        <svg viewBox="0 0 24 24" aria-hidden="true" class="jfy-refresh-icon">
                            <path d="M17.65 6.35A7.95 7.95 0 0012 4V1L7 6l5 5V8a4 4 0 11-4 4H6a6 6 0 106-6 5.98 5.98 0 014.24 1.76l1.41-1.41z" />
                        </svg>
                        <span>@(_isRefreshing ? "Searching…" : "Refresh feed")</span>
                    </button>
                </div>
            </header>

            <div class="jfy-context-strip">
                <div class="jfy-context-copy">
                    <span class="context-label">CURRENT SIGNALS</span>
                    <span class="context-text">Preferences + clicks + likes + comments + reading time</span>
                </div>
                <span class="context-dot"></span>
                <span class="context-status">AI + SEARXNG</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(_refreshMessage))
            {
                <p role="status" class="jfy-updated">@_refreshMessage</p>
            }
            @if (_isRefreshing && _recommendations.Count == 0)
            {
                <div class="jfy-state-card">
                    <h2>Building your recommendations…</h2>
                    <p>Searching your interests. Stories will appear as they become available.</p>
                </div>
            }
            else if (_recommendations.Count == 0)
            {
                <div class="jfy-state-card">
                    <h2>No fresh recommendations found</h2>
                    <p>Try refreshing later or add another preference.</p>
                </div>
            }
            else
            {
                <main class="jfy-grid" aria-label="Personalized news feed">
                    @foreach (var item in _recommendations)
                    {
                        var news = item.News;
                        var preference = item.Preference;
                        var hasImage = !string.IsNullOrWhiteSpace(news.DetailNews?.ImageUrl);

                        <button class="news-box-link @GetToneClass(preference)"
                                type="button"
                                @onclick="async () => await OpenRecommendationAsync(news)">
                            <article class="news-box">
                                <div class="card-media">
                                    @if (hasImage)
                                    {
                                        <img class="news-overview-image"
                                             src="@news.DetailNews!.ImageUrl"
                                             alt="@(news.DetailNews?.Keyword ?? preference)"
                                             loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="news-image-placeholder" aria-hidden="true">
                                            <span>@GetPreferenceInitial(preference)</span>
                                        </div>
                                    }

                                    <div class="card-media-shade"></div>
                                    <span class="category-tag">@preference</span>
                                    <span class="category-rank">@((_recommendations.IndexOf(item) + 1).ToString("00"))</span>
                                </div>

                                <div class="card-body">
                                    <div class="card-topline">
                                        <span class="ai-badge">@(item.IsSupplemental ? "AI EXTRA" : "AI PICK")</span>
                                        <span class="category-weight">@GetPreferenceLabel(item)</span>
                                    </div>

                                    <h2 class="news-title">@(news.DetailNews?.Keyword ?? "Untitled story")</h2>
                                    <p class="news-body">
                                        @(string.IsNullOrWhiteSpace(news.DetailNews?.Context)
                                            ? "Snippet unavailable for this story."
                                            : news.DetailNews.Context)
                                    </p>

                                    <div class="news-meta-row">
                                        <span class="news-meta">
                                            @((news.DetailNews?.NewsDate ?? news.CapturedDate).ToLocalTime().ToString("dd MMM yyyy"))
                                        </span>
                                        <span class="read-story">Open story <span aria-hidden="true">→</span></span>
                                    </div>
                                </div>
                            </article>
                        </button>
                    }
                </main>
            }
        }
    </div>

    <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
        <a href="/" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
            <span>Home</span>
        </a>
        <a href="/just-for-you" class="bottom-nav-item active">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
            <span>For You</span>
        </a>
        <a href="/search" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5 12.99 14 10.5 14 15 7.01 15 9.5 12.99 14 10.5 14z" /></svg>
            <span>Search</span>
        </a>
        <a href="/user-settings" class="bottom-nav-item">
            <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
            <span>Settings</span>
        </a>
    </nav>
</div>

@code {
    private readonly CancellationTokenSource _lifetime = new();
    private string? _refreshMessage;
    private bool _isInitialized;
    private bool _isRefreshing;
    private DateTimeOffset? _lastRefreshAt;
    private readonly List<string> _preferences = new();
    private List<RecommendationEngine.PersonalizedRecommendation> _recommendations = new();
    private bool _explorationMode;
    private const string FeedRefreshStorageKey = "nuctiusnow_feed_refresh_count";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await sessionService.InitializeAsync();
        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            _preferences.Clear();
            _preferences.AddRange(await GetPreferencesAsync(sessionService.UserId.Value));
        }
        _isInitialized = true;
        await InvokeAsync(StateHasChanged);
        if (sessionService.IsAuthenticated && _preferences.Count > 0)
            await RefreshRecommendationsAsync();
    }

    private async Task RefreshRecommendationsAsync()
    {
        if (_isRefreshing || !sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
            return;

        _isRefreshing = true;
        _refreshMessage = null;
        await InvokeAsync(StateHasChanged);

        try
        {
            _explorationMode = await RegisterFeedRefreshAsync();

            using var timeoutCts = CancellationTokenSource.CreateLinkedTokenSource(_lifetime.Token);
            timeoutCts.CancelAfter(TimeSpan.FromMinutes(5));
            using var scope = CreateUserScope();
            var engine = scope.ServiceProvider.GetRequiredService<RecommendationEngine>();
            var pending = new List<RecommendationEngine.PersonalizedRecommendation>();
            var completed = await engine.GetPersonalizedRecommendationsAsync(
                sessionService.UserId.Value,
                timeoutCts.Token,
                explorationMode: _explorationMode,
                onRecommendation: item => InvokeAsync(() =>
                {
                    if (_lifetime.IsCancellationRequested) return;
                    pending.Add(item);
                    _recommendations = pending.ToList();
                    StateHasChanged();
                }));
            if (!_lifetime.IsCancellationRequested) _recommendations = completed;

            _lastRefreshAt = DateTimeOffset.UtcNow;
        }
        catch (OperationCanceledException)
        {
            _refreshMessage = "The search timed out. Any stories already found are shown below. Try refreshing again.";
        }
        catch (Exception ex)
        {
            _refreshMessage = "Could not complete the search. Check that SearXNG is running and try again.";
            Console.Error.WriteLine($"JustForYou refresh failed: {ex}");
        }
        finally
        {
            _isRefreshing = false;
            if (!_lifetime.IsCancellationRequested) await InvokeAsync(StateHasChanged);
        }
    }

    private async Task<bool> RegisterFeedRefreshAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", FeedRefreshStorageKey);
            var count = int.TryParse(raw, out var parsed) ? parsed : 0;
            count = (count % 5) + 1;
            await JS.InvokeVoidAsync("localStorage.setItem", FeedRefreshStorageKey, count.ToString());
            return count == 5;
        }
        catch
        {
            return false;
        }
    }

    private async Task OpenRecommendationAsync(News news)
    {
        if (!sessionService.UserId.HasValue || news.IdNews <= 0)
            return;

        using var scope = CreateUserScope();
        await scope.ServiceProvider.GetRequiredService<RecommendationEngine>().RegisterCategoryClickAsync(
            sessionService.UserId.Value,
            news.IdNews);

        Navigation.NavigateTo($"/news-detail/{news.IdNews}");
    }

    private IServiceScope CreateUserScope()
    {
        var scope = ScopeFactory.CreateScope();
        if (scope.ServiceProvider.GetService<ILocalLlmService>() is UserAwareLocalLlmService search)
            search.SearchUserId = sessionService.UserId;
        return scope;
    }

    private async Task<List<string>> GetPreferencesAsync(int userId)
    {
        using var scope = CreateUserScope();
        return await scope.ServiceProvider.GetRequiredService<RecommendationEngine>().GetUserPreferencesAsync(userId);
    }

    public void Dispose()
    {
        _lifetime.Cancel();
        _lifetime.Dispose();
    }

    private static string GetToneClass(string preference)
    {
        var value = Math.Abs(preference.GetHashCode()) % 5;
        return $"tone-{value + 1}";
    }

    private static string GetPreferenceInitial(string preference) =>
        string.IsNullOrWhiteSpace(preference) ? "N" : preference.Trim()[0].ToString().ToUpperInvariant();

    private static string GetPreferenceLabel(RecommendationEngine.PersonalizedRecommendation item) =>
        item.Weight > 0 ? $"Weight {item.Weight}" : "Personalized";
}


