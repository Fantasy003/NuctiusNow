<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="NuctiusNow.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <script src="_framework/blazor.web.js"></script>

    <script src="https://www.google.com/recaptcha/api.js?render=6Le87EMtAAAAADDzoh70r-IgORbWTvdLvRCfb3vT"></script>

    <script>
        window.executeRecaptchaV3 = function (siteKey, actionName) {
            return new Promise((resolve, reject) => {
                try {
                    grecaptcha.ready(function () {
                        grecaptcha.execute(siteKey, { action: actionName }).then(function (token) {
                            resolve(token);
                        }).catch(err => reject(err));
                    });
                } catch (error) {
                    reject(error);
                }
            });
        };
    </script>
</body>

</html>
