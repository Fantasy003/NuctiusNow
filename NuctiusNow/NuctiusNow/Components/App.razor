<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="NuctiusNow.styles.css" />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/newsdetail.js"></script>
    <script src="js/theme.js"></script>
    <script src="js/searchscroll.js"></script>
    <script src="js/tts.js"></script>
    <script src="js/nuctiusTts.js"></script>

    <!-- Agregamos async y defer para no bloquear el renderizado -->
    <script src="https://www.google.com/recaptcha/api.js?onload=onRecaptchaLoaded&render=explicit" async defer></script>

    <script>
        window.recaptchaReady = false;

        window.onRecaptchaLoaded = function () {
            window.recaptchaReady = true;
        };

        window.renderRecaptchaCheckbox = function (containerId, siteKey) {
            return new Promise((resolve) => {
                const tryRender = () => {
                    try {
                        if (!window.grecaptcha || !window.grecaptcha.render) {
                            setTimeout(tryRender, 250);
                            return;
                        }

                        const container = document.getElementById(containerId);
                        if (!container) {
                            resolve("");
                            return;
                        }

                        if (window.__registerRecaptchaWidgetId !== undefined) {
                            const existingToken = window.grecaptcha.getResponse(window.__registerRecaptchaWidgetId);
                            resolve(existingToken || "");
                            return;
                        }

                        window.__registerRecaptchaWidgetId = window.grecaptcha.render(container, {
                            sitekey: siteKey,
                            callback: function (token) {
                                resolve(token || "");
                            },
                            "expired-callback": function () {
                                resolve("");
                            },
                            "error-callback": function () {
                                resolve("");
                            }
                        });
                    } catch (error) {
                        // CAPTURA EL BLOQUEO DEL NAVEGADOR SIN ROMPER BLAZOR
                        console.warn("reCAPTCHA fue bloqueado por la privacidad del navegador:", error);
                        resolve(""); 
                    }
                };

                tryRender();
            });
        };

        window.getRecaptchaToken = function () {
            try {
                if (!window.grecaptcha || window.__registerRecaptchaWidgetId === undefined) {
                    return "";
                }
                return window.grecaptcha.getResponse(window.__registerRecaptchaWidgetId);
            } catch (e) {
                return "";
            }
        };

        window.resetRecaptchaCheckbox = function () {
            try {
                if (window.grecaptcha && window.__registerRecaptchaWidgetId !== undefined) {
                    window.grecaptcha.reset(window.__registerRecaptchaWidgetId);
                }
            } catch (e) {
                console.warn("No se pudo reiniciar reCAPTCHA:", e);
            }
        };
    </script>
</body>

</html>

