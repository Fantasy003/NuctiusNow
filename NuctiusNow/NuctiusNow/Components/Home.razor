        public string ImagenUrlRespaldoInternet { get; set; } // Link estático de internet por si la IA no encuentra nada
    }

    private List<CategoriaModel> Categorias = new();

    protected override void OnInitialized()
    {
        // Simulamos la carga inicial. Cuando la IA busque, seteará 'ImagenNoticiaIA'
