@page "/"

@using System.Collections.Concurrent
@using Microsoft.JSInterop
@using Microsoft.EntityFrameworkCore
@using NuctiusNow.Data
@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related
@inject UserSessionService sessionService
@inject RecommendationEngine RecommendationEngine
@inject CategoryNewsService CategoryNewsService
@inject NavigationManager Navigation
@inject IJSRuntime JS

<PageTitle>NuctiusNow - Home</PageTitle>

<div class="home-container">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <span class="section-kicker">NUCTIUSNOW / PERSONALIZED DESK</span>
            <h1 id="home-title" class="home-heading">Latest Personalized News</h1>
            <p class="home-subheading">
                AI searches beyond the category label to discover related people, topics, events and stories.
            </p>
        </div>

        <div class="home-hero-status">
            <span class="status-dot"></span>
            <span>@(sessionService.IsAuthenticated ? "AI feed active" : "Public feed")</span>
        </div>
    </section>

    <main class="categories-grid" aria-label="Personalized news categories">
        @foreach (var cat in Categories)
        {
            var isLoading = _isLoading.GetValueOrDefault(cat.Name, false);
            var hottestNews = _hottestNewsByCategory.GetValueOrDefault(cat.Name);
            var hasImage = HasNewsImage(hottestNews);

            <button class="category-card-link @GetCategoryToneClass(cat.Name)"
                    type="button"
                    @onclick="async () => await OpenCategoryNews(cat.Name, hottestNews)"
                    disabled="@(isLoading || hottestNews == null)"
                    aria-label="Open @cat.Name news">
                <article class="category-card">
                    <div class="category-card-media">
                        @if (hasImage && hottestNews != null)
                        {
                            <img data-news-text class="category-card-image"
                                 src="@hottestNews.DetailNews!.ImageUrl"
                                 alt="@(hottestNews.DetailNews?.Keyword ?? cat.Name)"
                                 loading="lazy" />
                        }
                        else
                        {
                            <div class="category-card-placeholder" aria-hidden="true">
                                <span>@GetCategoryInitial(cat.Name)</span>
                            </div>
                        }

                        <div class="category-card-shade"></div>
                        <span class="category-tag-pill">@cat.Name</span>
                        <span class="category-card-index">@GetCategoryIndex(cat.Name)</span>
                    </div>

                    <div class="category-card-content">
                        @if (isLoading)
                        {
                            <div class="card-skeleton-line card-skeleton-title"></div>
                            <div class="card-skeleton-line"></div>
                            <div class="card-skeleton-line card-skeleton-short"></div>
                            <span class="news-meta">AI is finding a fresh story…</span>
                        }
                        else if (hottestNews != null)
                        {
                            <div class="category-card-topline">
                                <span class="ai-badge">AI PICK</span>
                                @if (_sourceByCategory.TryGetValue(cat.Name, out var source) &&
                                     source == NewsSelectionSource.DatabaseRandomFallback)
                                {
                                    <span class="news-status">Archive fallback</span>
                                }
                            </div>

                            <h2 class="category-title" data-news-text>
                                @(hottestNews.DetailNews?.Keyword ?? "Untitled story")
                            </h2>

                            <p class="news-summary" data-news-text>
                                @(string.IsNullOrWhiteSpace(hottestNews.DetailNews?.Context)
                                    ? "Snippet unavailable for this story."
                                    : hottestNews.DetailNews.Context)
                            </p>

                            <div class="news-meta-row">
                                <span class="news-meta">
                                    @((hottestNews.DetailNews?.NewsDate ?? hottestNews.CapturedDate).ToLocalTime().ToString("dd MMM yyyy"))
                                </span>
                                <span class="read-story">Read story <span aria-hidden="true">→</span></span>
                            </div>
                        }
                        else
                        {
                            <div class="category-card-topline">
                                <span class="ai-badge muted">NO RESULT</span>
                            </div>
                            <h2 class="category-title" data-news-text>No recent news</h2>
                            <p class="news-summary" data-news-text>We couldn't find an article for this category right now.</p>
                        }
                    </div>
                </article>
            </button>
        }
    </main>

    <footer class="home-footer">
        <span>Recommendations refresh when you return to this page.</span>
        <span class="home-footer-line"></span>
    </footer>
</div>

@code {
    private List<Category> Categories { get; set; } = new();
    private readonly ConcurrentDictionary<string, bool> _isLoading = new();
    private readonly ConcurrentDictionary<string, News?> _hottestNewsByCategory = new();
    private readonly ConcurrentDictionary<string, NewsSelectionSource> _sourceByCategory = new();
    private bool _explorationMode;
    private const string FeedRefreshStorageKey = "nuctiusnow_feed_refresh_count";

    protected override void OnInitialized()
    {

        var mapping = InternetSearchService.GetCategoryMapping();
        Categories = mapping
            .Select(m => new Category(m.Category))
            .ToList();

        foreach (var category in Categories)
        {
            _isLoading[category.Name] = true;
            _hottestNewsByCategory[category.Name] = null;
            _sourceByCategory[category.Name] = NewsSelectionSource.None;
        }

    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await sessionService.InitializeAsync();
            _explorationMode = await RegisterFeedRefreshAsync();
            await LoadAllCategoriesAsync(Categories.Select(x => x.Name).ToList());
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Home feed initialization failed: {ex}");
        }
    }

    private async Task<bool> RegisterFeedRefreshAsync()
    {
        try
        {
            var raw = await JS.InvokeAsync<string?>("localStorage.getItem", FeedRefreshStorageKey);
            var count = int.TryParse(raw, out var parsed) ? parsed : 0;
            count = (count % 5) + 1;
            await JS.InvokeVoidAsync("localStorage.setItem", FeedRefreshStorageKey, count.ToString());
            return count == 5;
        }
        catch
        {
            return false;
        }
    }

    private async Task LoadAllCategoriesAsync(IReadOnlyCollection<string> categories)
    {
        var tasks = categories.Select(LoadCategoryNewsAsync);
        await Task.WhenAll(tasks);
        await InvokeAsync(StateHasChanged);
    }

    private async Task LoadCategoryNewsAsync(string category)
    {
        try
        {
            using var timeoutCts = new CancellationTokenSource(TimeSpan.FromMinutes(3));
            var userId = sessionService.IsAuthenticated ? sessionService.UserId : null;

            var result = await CategoryNewsService.GetNewsForCategoryAsync(
                category,
                userId,
                timeoutCts.Token,
                forceAiSearchFirst: true,
                forceRandomSelection: _explorationMode);

            _hottestNewsByCategory[category] = result.News;
            _sourceByCategory[category] = result.Source;

            // Home deliberately avoids a second AI call for image discovery.
            // The first phase is only category news retrieval; article/image enrichment
            // remains deferred to the detail page.
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Unexpected error loading category {category}: {ex}");
            _hottestNewsByCategory[category] = null;
            _sourceByCategory[category] = NewsSelectionSource.None;
        }
        finally
        {
            _isLoading[category] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenCategoryNews(string category, News? news)
    {
        if (news == null || news.IdNews <= 0) return;

        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            var userId = sessionService.UserId.Value;
            await RecommendationEngine.RegisterCategoryClickAsync(userId, news.IdNews);
            await CategoryNewsService.RegisterNewsViewAsync(userId, news.IdNews);
        }

        Navigation.NavigateTo($"/news-detail/{news.IdNews}");
    }

    private static bool HasNewsImage(News? news) =>
        !string.IsNullOrWhiteSpace(news?.DetailNews?.ImageUrl);

    private static string GetCategoryInitial(string category) =>
        string.IsNullOrWhiteSpace(category) ? "N" : category.Trim()[0].ToString().ToUpperInvariant();

    private static string GetCategoryIndex(string category) =>
        ((uint)category.GetHashCode() % 100).ToString("00").Substring(0, 2);

    private static string GetCategoryToneClass(string category)
    {
        var value = (int)(uint)category.GetHashCode() % 5;
        return $"tone-{value + 1}";
    }

    public record Category(string Name);
}

