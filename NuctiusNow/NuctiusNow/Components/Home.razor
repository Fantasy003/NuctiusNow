@page "/"

@using Microsoft.EntityFrameworkCore
@using System.Collections.Concurrent
@using NuctiusNow.Data
@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related
@inject ApplicationDbContext DbContext
@inject UserSessionService sessionService
@inject RecommendationEngine RecommendationEngine
@inject NavigationManager Navigation

<PageTitle>NuctiusNow - Home</PageTitle>

<div class="home-container">
    <header class="home-header">
        <h1 class="home-heading">Latest Personalized News</h1>
        <p class="home-subheading">Selected by our AI engine based on your interests.</p>
    </header>

    <div class="categories-grid">
        @foreach (var cat in Categories)
        {
            var isLoading = _isLoading.GetValueOrDefault(cat.Name, false);
            var hottestNews = _hottestNewsByCategory.GetValueOrDefault(cat.Name);

            <div class="category-card-link" role="button" tabindex="0"
                 @onclick="async () => await OpenCategoryNews(cat.Name, hottestNews)"
                 @onkeydown="@(async e => { if (e.Key == "Enter") await OpenCategoryNews(cat.Name, hottestNews); })">
                <div class="category-card" style="background-image: url('@cat.BackupImageUrl');">
                    <div class="card-overlay"></div>
                    <div class="card-content">
                        @if (isLoading)
                        {
                            <span class="category-tag-pill">@cat.Name</span>
                            <h2 class="category-title">Loading...</h2>
                        }
                        else if (hottestNews != null)
                        {
                            <span class="category-tag-pill">@cat.Name</span>
                            <h2 class="category-title">@(hottestNews.DetailNews?.Keyword ?? "No Title Available")</h2>
                            <span class="news-meta">@hottestNews.CapturedDate.ToString("dd MMM yyyy")</span>
                        }
                        else
                        {
                            <span class="category-tag-pill">@cat.Name</span>
                            <h2 class="category-title">@cat.Name.ToUpper()</h2>
                            <span class="news-meta">No recent news</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@code {
    private List<Category> Categories { get; set; } = new();
    private readonly ConcurrentDictionary<string, bool> _isLoading = new();
    private readonly ConcurrentDictionary<string, News?> _hottestNewsByCategory = new();

    protected override async Task OnInitializedAsync()
    {
        await sessionService.InitializeAsync();

        var mapping = InternetSearchService.GetCategoryMapping();
        Categories = mapping.Select(m => new Category(m.Category, $"https://source.unsplash.com/random/500x500/?{m.Category}")).ToList();

        foreach (var category in mapping.Select(x => x.Category).ToList())
        {
            _isLoading[category] = true;
            _hottestNewsByCategory[category] = null;
        }

        foreach (var category in mapping.Select(x => x.Category).ToList())
        {
            _ = LoadCategoryNewsAsync(category);
        }
    }

    private async Task LoadCategoryNewsAsync(string category)
    {
        _isLoading[category] = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var news = await RecommendationEngine.ExecuteAiSearchForCategoryAsync(category);

            if (news == null)
            {
                news = await DbContext.News
                    .Include(n => n.Tag)
                    .Include(n => n.DetailNews)
                    .Where(n => n.Tag != null && n.Tag.Name == category)
                    .OrderByDescending(n => n.CapturedDate)
                    .FirstOrDefaultAsync();
            }

            _hottestNewsByCategory[category] = news;
        }
        catch
        {
            // Mantener estado vacío para la categoría si falla la IA
        }
        finally
        {
            _isLoading[category] = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenCategoryNews(string category, News? news)
    {
        if (news == null || news.IdNews <= 0)
        {
            return;
        }

        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            await RecommendationEngine.RegisterCategoryClickAsync(sessionService.UserId.Value, news.IdNews);
        }

        Navigation.NavigateTo($"/news-detail/{news.IdNews}");
    }

    public record Category(string Name, string BackupImageUrl);
}
