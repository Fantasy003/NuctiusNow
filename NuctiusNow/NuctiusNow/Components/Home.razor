@page "/"

<div class="home-page-container">
    <div class="home-wrapper">

        <div class="categories-grid">
            @foreach (var cat in Categorias)
            {
                var imagenACargar = !string.IsNullOrEmpty(cat.ImagenNoticiaIA)
                ? cat.ImagenNoticiaIA
                : cat.ImagenUrlRespaldoInternet;

                <a href="/news/@cat.Id" class="category-card-link">
                    <div class="category-card" style="background-image: url('@imagenACargar');">
                        <div class="card-overlay"></div>
                        <h2 class="category-title">@cat.Nombre.ToUpper()</h2>
                    </div>
                </a>
            }
        </div>

        <div class="floating-menu-container">
            <div class="floating-menu-card">

                <div class="menu-content">
                    <div class="menu-actions">
                        <NavLink href=""><button class="menu-btn menu-btn-active">Home</button></NavLink>
                        <NavLink href="just-for-you"><button class="menu-btn">Just for you</button></NavLink>
                        <NavLink href="user-settings"><button class="menu-btn">User settings</button></NavLink>
                        <button class="menu-btn">Help</button>
                    </div>

                    <div class="premium-box">
                        <h4>Premium Status</h4>
                        @if (isPremium && isUserLoggedIn)
                        {
                            <div class="status-badge active">🟢 Activo</div>
                        }
                        else
                        {
                            <div class="status-badge inactive">🔴 Inactivo</div>
                        }
                    </div>
                </div>

                <div class="menu-tab">
                    <span>NuctiusNow</span>
                </div>
            </div>
        </div>

    </div>
</div>

@code {
    private bool isUserLoggedIn = true;
    private bool isPremium = true;
    // Modelo básico para renderizar el grid dinámicamente
    public class CategoriaModel
    {
        public string Id { get; set; }
        public string Nombre { get; set; }
