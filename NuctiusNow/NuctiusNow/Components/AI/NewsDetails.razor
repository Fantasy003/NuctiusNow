@rendermode InteractiveServer

<PageTitle>Detalle de la Noticia - NuctiusNow</PageTitle>

<div class="detalle-page-container">

    <div class="back-nav">
        <NavLink href="just-for-you" class="btn-back">⬅ Volver a Just For You</NavLink>
    </div>

    <article class="detalle-card">
        <div class="meta-info">
            <span class="categoria">@Categoria</span>
            <span class="noticia-id">News N°: #@Id</span>
        </div >

        <h1 class="detalle-title">@Titulo</h1>

        <div class="detalle-content-layout">
            <img src="@UrlImagen" class="detalle-img" alt="Imagen Noticia Full" />

            <div class="detalle-text">
                <h3>Resumen Principal</h3>
                <p class="body-destacado">@Contenido</p>

                <h3>Cuerpo Completo de la Noticia</h3>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
                <p>Añadiendo contexto real a la información visual analizada de la aplicación, este segmento de datos simula el despliegue dinámico de información extendida requerida para la experiencia del usuario final en portales premium.</p>
            </div >
        </div>

        <div class="article-actions-bar">
            <div class="reactions-group">
                <button class="btn-action btn-like @(hasLiked ? "active-like" : "")" @onclick="ManejarLike">
                    <span class="action-icon">👍</span>
                    <span class="action-count">@likeCount</span>
                </button>

                <button class="btn-action btn-dislike @(hasDisliked ? "active-dislike" : "")" @onclick="ManejarDislike">
                    <span class="action-icon">👎</span>
                </button>
            </div >

            <button class="btn-action btn-share" @onclick="ManejarShare">
                <span class="action-icon">📨</span> Share
            </button>
        </div >
    </article>

</div>

@code {
    [Inject]
    public AIService AIService { get; set; } // Inject the AI Service

    [Parameter] public int Id { get; set; }

    private string Categoria { get; set; } = "Cargando...";
    private string Titulo { get; set; } = "Cargando...";
    private string Contenido { get; set; } = "";
    private string UrlImagen { get; set; } = "https://picsum.photos/400/300";

    // Estados de interacción simulados
    private int likeCount = 42;
    private bool hasLiked = false;
    private bool hasDisliked = false;

    protected override async Task OnInitializedAsync() // Changed to async to allow await calls
    {
        await base.OnInitializedAsync();

        // --- Data Loading Logic (Modified) ---
        if (Id == 1) { Categoria = "Technology"; Titulo = "NVIDIA: SPARK PROCESSOR"; UrlImagen = "https://picsum.photos/id/0/400/300"; }
        else if (Id == 2) { Categoria = "Sports"; Titulo = "WORLD CUP: URUGUAY ELIMINATED"; UrlImagen = "https://picsum.photos/id/73/400/300"; }
        else if (Id == 3) { Categoria = "Weather"; Titulo = "ARGENTINA: RAINING ON MONDAY"; UrlImagen = "https://picsum.photos/id/401/400/300"; }
        else // Default case, simulate AI processing for unknown IDs or specific testing ID
        {
            if (Id == 999) // Specific ID to trigger the AI workflow simulation
            {
                try
                {
                    // Simulate fetching data from an external source URL and updating state variables directly.
                    var (news, detailNews) = await AIService.ProcessAndSaveNewsAsync("http://example.com/ai-article");
                    Titulo = GetObjectStringProperty(news, "Title", "title", "Headline", "NewsTitle") ?? "AI Generated Headline";
                    Categoria = GetObjectStringProperty(news, "Category", "category", "Section", "Topic") ?? "AI Insight";
                    UrlImagen = GetObjectStringProperty(news, "ImageUrl", "imageUrl", "Image", "Url") ?? "https://picsum.photos/id/160/400/300";
                    Contenido = GetObjectStringProperty(detailNews, "Context", "context", "Summary", "Content", "Body") ?? "No summary context available from AI service.";

                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error processing AI news: {ex.Message}");
                    Titulo = $"Failed to Load Details for ID {Id}";
                    Categoria = "Error";
                    Contenido = $"Could not load detailed content using AI Service. Error: {ex.Message}";
                }
            }
            else // Fallback for other IDs without explicit logic
            {
                 Categoria = "Technology"; 
                 Titulo = $"News Article Title Placeholder (ID: {Id})"; 
                 UrlImagen = "https://picsum.photos/id/160/400/300"; 
                 Contenido = "DASDADADADAADASDDADSADASDASDASDASDASDASDADADADADADADADADADADADADADADADASDASDASDADADADASDADADASDADADADSADADADADADADDADASDADADADADADASDADADADADSDDADADADADADADADADADADADADADADADSADASDASDADADADSADADADADADASDADADADA";
            }
        }
    }

    private void ManejarLike()
    {
        if (hasLiked)
        {
            likeCount--;
            hasLiked = false;
        }
        else
        {
            likeCount++;
            hasLiked = true;
            if (hasDisliked) hasDisliked = false; // Desmarca dislike si estaba activo
        }
    }

    private void ManejarDislike()
    {
        if (hasDisliked)
        {
            hasDisliked = false;
        }
        else
        {
            hasDisliked = true;
            if (hasLiked)
            {
                likeCount--;
                hasLiked = false; // Desmarca like si estaba activo
            }
        }
    }

    private void ManejarShare()
    {
        Console.WriteLine($"Enlace de la noticia #{Id} copiado al portapapeles.");
    }

    private string GetObjectStringProperty(object source, params string[] propertyNames)
    {
        if (source == null || propertyNames == null || propertyNames.Length == 0)
        {
            return null;
        }

        if (source is System.Collections.Generic.IDictionary<string, object> dict)
        {
            foreach (var name in propertyNames)
            {
                if (dict.TryGetValue(name, out var value) && value != null)
                {
                    return value.ToString();
                }
            }

            foreach (var name in propertyNames)
            {
                foreach (var key in dict.Keys)
                {
                    if (string.Equals(key, name, StringComparison.OrdinalIgnoreCase) && dict[key] != null)
                    {
                        return dict[key].ToString();
                    }
                }
            }
        }

        var type = source.GetType();
        foreach (var name in propertyNames)
        {
            var prop = type.GetProperty(name, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
            if (prop != null)
            {
                var value = prop.GetValue(source);
                if (value != null)
                {
                    return value.ToString();
                }
            }
        }

        return null;
    }
}