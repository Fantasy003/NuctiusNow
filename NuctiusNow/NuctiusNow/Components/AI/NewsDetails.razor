@rendermode InteractiveServer

<PageTitle>News Detail - NuctiusNow</PageTitle>

<div class="detail-page-container">

    <div class="back-nav">
        <NavLink href="just-for-you" class="btn-back">⬅ Back to Just For You</NavLink>
    </div>

    <article class="detail-card">
        <div class="meta-info">
            <span class="category">@Category</span>
            <span class="news-id">News #: #@Id</span>
        </div >

        <h1 class="detail-title">@Title</h1>

        <div class="detail-content-layout">
            <img src="@ImageUrl" class="detail-img" alt="News Image Full" />

            <div class="detail-text">
                <h3>Main Summary</h3>
                <p class="body-featured">@Content</p>

                <h3>Full Article Body</h3>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
                <p>Adding contextual information and simulated content for the full article body displayed in premium portals.</p>
            </div >
        </div>

        <div class="article-actions-bar">
            <div class="reactions-group">
                <button class="btn-action btn-like @(hasLiked ? "active-like" : "")" @onclick="HandleLike">
                    <span class="action-icon">👍</span>
                    <span class="action-count">@likeCount</span>
                </button>

                <button class="btn-action btn-dislike @(hasDisliked ? "active-dislike" : "")" @onclick="HandleDislike">
                    <span class="action-icon">👎</span>
                </button>
            </div >

            <button class="btn-action btn-share" @onclick="HandleShare">
                <span class="action-icon">📨</span> Share
            </button>
        </div >
    </article>

</div>

@code {
    [Inject]
    public AIService AIService { get; set; } // Inject the AI Service

    [Parameter] public int Id { get; set; }

    private string Category { get; set; } = "Loading...";
    private string Title { get; set; } = "Loading...";
    private string Content { get; set; } = "";
    private string ImageUrl { get; set; } = "https://picsum.photos/400/300";

    // Interaction state
    private int likeCount = 42;
    private bool hasLiked = false;
    private bool hasDisliked = false;

    protected override async Task OnInitializedAsync() // Changed to async to allow await calls
    {
        await base.OnInitializedAsync();

        // --- Data Loading Logic (Modified) ---
        if (Id == 1) { Category = "Technology"; Title = "NVIDIA: SPARK PROCESSOR"; ImageUrl = "https://picsum.photos/id/0/400/300"; }
        else if (Id == 2) { Category = "Sports"; Title = "WORLD CUP: URUGUAY ELIMINATED"; ImageUrl = "https://picsum.photos/id/73/400/300"; }
        else if (Id == 3) { Category = "Weather"; Title = "ARGENTINA: RAINING ON MONDAY"; ImageUrl = "https://picsum.photos/id/401/400/300"; }
        else // Default case, simulate AI processing for unknown IDs or specific testing ID
        {
            if (Id == 999) // Specific ID to trigger the AI workflow simulation
            {
                try
                {
                    // Simulate fetching data from an external source URL and updating state variables directly.
                    var (news, detailNews) = await AIService.ProcessAndSaveNewsAsync("http://example.com/ai-article");
                    Title = GetObjectStringProperty(news, "Title", "title", "Headline", "NewsTitle") ?? "AI Generated Headline";
                    Category = GetObjectStringProperty(news, "Category", "category", "Section", "Topic") ?? "AI Insight";
                    ImageUrl = GetObjectStringProperty(news, "ImageUrl", "imageUrl", "Image", "Url") ?? "https://picsum.photos/id/160/400/300";
                    Content = GetObjectStringProperty(detailNews, "Context", "context", "Summary", "Content", "Body") ?? "No summary context available from AI service.";

                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Error processing AI news: {ex.Message}");
                    Title = $"Failed to Load Details for ID {Id}";
                    Category = "Error";
                    Content = $"Could not load detailed content using AI Service. Error: {ex.Message}";
                }
            }
            else // Fallback for other IDs without explicit logic
            {
                 Category = "Technology"; 
                 Title = $"News Article Title Placeholder (ID: {Id})"; 
                 ImageUrl = "https://picsum.photos/id/160/400/300"; 
                 Content = "DASDADADADAADASDDADSADASDASDASDASDASDASDADADADADADADADADADADADADADADADASDASDASDADADADASDADADASDADADADSADADADADADADDADASDADADADADADASDADADADADSDDADADADADADADADADADADADADADADADSADASDASDADADADSADADADADADASDADADADA";
            }
        }
    }

    private void HandleLike()
    {
        if (hasLiked)
        {
            likeCount--;
            hasLiked = false;
        }
        else
        {
            likeCount++;
            hasLiked = true;
            if (hasDisliked) hasDisliked = false; // clear dislike if it was active
        }
    }

    private void HandleDislike()
    {
        if (hasDisliked)
        {
            hasDisliked = false;
        }
        else
        {
            hasDisliked = true;
            if (hasLiked)
            {
                likeCount--;
                hasLiked = false; // clear like if it was active
            }
        }
    }

    private void HandleShare()
    {
        Console.WriteLine($"News link #{Id} copied to clipboard.");
    }

    private string GetObjectStringProperty(object source, params string[] propertyNames)
    {
        if (source == null || propertyNames == null || propertyNames.Length == 0)
        {
            return null;
        }

        if (source is System.Collections.Generic.IDictionary<string, object> dict)
        {
            foreach (var name in propertyNames)
            {
                if (dict.TryGetValue(name, out var value) && value != null)
                {
                    return value.ToString();
                }
            }

            foreach (var name in propertyNames)
            {
                foreach (var key in dict.Keys)
                {
                    if (string.Equals(key, name, StringComparison.OrdinalIgnoreCase) && dict[key] != null)
                    {
                        return dict[key].ToString();
                    }
                }
            }
        }

        var type = source.GetType();
        foreach (var name in propertyNames)
        {
            var prop = type.GetProperty(name, System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance | System.Reflection.BindingFlags.IgnoreCase);
            if (prop != null)
            {
                var value = prop.GetValue(source);
                if (value != null)
                {
                    return value.ToString();
                }
            }
        }

        return null;
    }
}