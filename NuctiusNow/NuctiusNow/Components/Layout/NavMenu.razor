@inject NavigationManager Navigation

<!-- ── Top Navigation Bar ── -->
<header class="top-nav">
    <div class="top-nav-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo">
            <span class="logo-accent">N</span>uctiusNow
        </a>

        <!-- Desktop links -->
        <nav class="nav-links" aria-label="Main navigation" style="display:flex; gap:1.5rem;">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link-item">
                <svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/></svg>
                <span>Home</span>
            </NavLink>
            <NavLink href="just-for-you" class="nav-link-item">
                <svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z"/></svg>
                <span>For You</span>
            </NavLink>
            <NavLink href="user-settings" class="nav-link-item">
                <svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
                <span>Settings</span>
            </NavLink>
            <!-- Search button -->
            <NavLink href="search" class="nav-link-item">
                <svg viewBox="0 0 24 24" class="nav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/></svg>
                <span>Search</span>
            </NavLink>
        </nav>

        <!-- Hamburger toggle (mobile) -->
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu" aria-expanded="@menuOpen">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <!-- Mobile dropdown menu -->
    @if (menuOpen)
    {
        <nav class="mobile-dropdown" aria-label="Mobile navigation">
            <NavLink href="" Match="NavLinkMatch.All" class="mobile-nav-item" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="just-for-you" class="mobile-nav-item" @onclick="CloseMenu">For You</NavLink>
            <NavLink href="user-settings" class="mobile-nav-item" @onclick="CloseMenu">Settings</NavLink>
            <NavLink href="search" class="mobile-nav-item" @onclick="CloseMenu">Search</NavLink>
        </nav>
    }
</header>

@code {
    private bool menuOpen = false;

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu()  => menuOpen = false;

    protected override void OnInitialized()
    {
        // Close menu on navigation
        Navigation.LocationChanged += (_, __) => { menuOpen = false; InvokeAsync(StateHasChanged); };
    }
}
