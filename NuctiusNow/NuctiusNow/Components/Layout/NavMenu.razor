@inject NavigationManager Navigation

<!-- ── Top Navigation Bar ── -->
<header class="top-nav">
    <div class="top-nav-inner">
        <!-- Logo -->
        <a href="/" class="nav-logo">
            <span class="logo-accent">N</span>uctiusNow
        </a>

        <!-- Desktop links -->
        <nav class="nav-links" aria-label="Main navigation">
            <NavLink href="" Match="NavLinkMatch.All" class="nav-link-item">Home</NavLink>
            <NavLink href="just-for-you" class="nav-link-item">For You</NavLink>
            <NavLink href="user-settings" class="nav-link-item">Settings</NavLink>
        </nav>

        <!-- Hamburger toggle (mobile) -->
        <button class="hamburger" @onclick="ToggleMenu" aria-label="Menu" aria-expanded="@menuOpen">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <!-- Mobile dropdown menu -->
    @if (menuOpen)
    {
        <nav class="mobile-dropdown" aria-label="Mobile navigation">
            <NavLink href="" Match="NavLinkMatch.All" class="mobile-nav-item" @onclick="CloseMenu">Home</NavLink>
            <NavLink href="just-for-you" class="mobile-nav-item" @onclick="CloseMenu">For You</NavLink>
            <NavLink href="user-settings" class="mobile-nav-item" @onclick="CloseMenu">Settings</NavLink>
        </nav>
    }
</header>

@code {
    private bool menuOpen = false;

    private void ToggleMenu() => menuOpen = !menuOpen;
    private void CloseMenu()  => menuOpen = false;

    protected override void OnInitialized()
    {
        // Close menu on navigation
        Navigation.LocationChanged += (_, __) => { menuOpen = false; InvokeAsync(StateHasChanged); };
    }
}
