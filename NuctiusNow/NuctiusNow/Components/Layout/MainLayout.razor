@inherits LayoutComponentBase
@inject ThemeState ThemeState
@implements IDisposable

<!-- Envolvemos todo el layout con la variable dinámica -->
<div class="theme-@ThemeState.CurrentTheme" style="min-height: 100vh; background-color: var(--bg-main); color: var(--text-main); transition: background-color 0.3s ease;">

    <main>
        <!-- Tu menú de navegación o headers van acá -->

        <article class="content">
            @Body
        </article>
    </main>

</div>

@code {
    protected override void OnInitialized()
    {
        // Nos suscribimos a los cambios de tema
        ThemeState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        // Nos desuscribimos para evitar memory leaks
        ThemeState.OnChange -= StateHasChanged;
    }
}