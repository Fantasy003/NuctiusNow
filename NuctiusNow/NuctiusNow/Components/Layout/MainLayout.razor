@inherits LayoutComponentBase
@inject ThemeState ThemeState
@inject IJSRuntime JSRuntime
@inject NavigationManager Navigation
@implements IDisposable

<div class="@(ThemeEnabled ? $"theme-{ThemeState.CurrentTheme} app-shell" : "app-shell")">

    <SiteLocalization />
    <NavMenu />

    <main class="page-body">
        @Body
    </main>

    <Chatbot />

</div>

@code {
    private string? appliedDocumentTheme;

    private bool ThemeEnabled =>
        !IsExcludedThemeRoute(Navigation.Uri);

    protected override void OnInitialized()
    {
        ThemeState.OnChange += StateHasChanged;
        Navigation.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var savedTheme = await JSRuntime.InvokeAsync<string>(
                "localStorage.getItem",
                "selectedTheme");

            if (!string.IsNullOrWhiteSpace(savedTheme))
                ThemeState.SetTheme(savedTheme);

        }
        var theme = ThemeEnabled ? ThemeState.CurrentTheme : "dark";
        if (theme != appliedDocumentTheme) await ApplyDocumentThemeAsync();
    }

    private async void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await ApplyDocumentThemeAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyDocumentThemeAsync()
    {
        var theme = ThemeEnabled ? ThemeState.CurrentTheme : "dark";
        await JSRuntime.InvokeVoidAsync("nuctiusTheme.set", theme);
        appliedDocumentTheme = theme;
    }

    private static bool IsExcludedThemeRoute(string uri)
    {
        var path = new Uri(uri).AbsolutePath.Trim('/');
        return path.Equals("login", StringComparison.OrdinalIgnoreCase) ||
               path.Equals("register", StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        ThemeState.OnChange -= StateHasChanged;
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
