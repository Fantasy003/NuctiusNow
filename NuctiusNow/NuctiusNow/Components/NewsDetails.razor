@page "/news-detail/{Id:int}"
@implements IAsyncDisposable

@using System.Diagnostics
@using System.Text.RegularExpressions
@using Microsoft.EntityFrameworkCore
@using NuctiusNow.Data
@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related
@inject UserSessionService sessionService
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject RecommendationEngine recommendationEngine
@inject IJSRuntime JS

<PageTitle>News Details - NuctiusNow</PageTitle>

@if (isLoading)
{
    <div class="news-detail-page" style="display:flex; justify-content:center; align-items:center; padding-top: 4rem;">
        <div class="loading-spinner"></div>
    </div>
}
else if (currentNews == null)
{
    <div class="news-detail-page" style="display:flex; justify-content:center; align-items:center; padding-top: 4rem;">
        <div class="error-message">Requested news not found.</div>
    </div>
}
else
{
    <div class="news-detail-page">
        <div class="back-nav">
            <button class="btn-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:currentColor;"><path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" /></svg>
                Back
            </button>
        </div>

        <article class="detail-card">
            <div class="meta-info">
                <span class="category">@(currentNews.Tag?.Name ?? "General")</span>
                <span class="news-id">@currentNews.CapturedDate.ToString("MMM d, yyyy - HH:mm")</span>
            </div>

            <h1 class="detail-title">@(currentNews.DetailNews?.Keyword ?? "No Title Available")</h1>

            <div class="detail-content-layout">
                @if (!string.IsNullOrWhiteSpace(heroImageUrl))
                {
                    <img src="@heroImageUrl" class="detail-img" alt="Article image" />
                }

                <div class="detail-text">
                    <!-- NEW: AI Summary Section -->
                    <div class="summary-section" style="background-color: #f0f7ff; padding: 1.2rem; border-left: 4px solid #007bff; border-radius: 4px; margin-bottom: 2rem;">
                        <h3 style="margin-top: 0; color: #0056b3; font-size: 1.1rem;">AI Summary</h3>
                        <p style="margin-bottom: 0;">@(currentNews.DetailNews?.Context ?? "No summary available.")</p>
                    </div>

                    <!-- Full Article Section -->
                    <div class="full-article-section">
                        @if (isExtractingFullBodyText)
                        {
                            <p><i>Extracting the full article text...</i></p>
                        }
                        else if (!string.IsNullOrWhiteSpace(currentNews.DetailNews?.FullBodyText))
                        {
                            <div class="full-article-body">@currentNews.DetailNews.FullBodyText</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(fullBodyError))
                        {
                            <p><i>@fullBodyError</i></p>
                        }
                        else
                        {
                            <p><i>The full text for this article is not available.</i></p>
                        }
                    </div>
                </div>
            </div>

            <div class="article-actions-bar">
                <div class="reactions-group">
                    <button class="btn-action btn-like @(hasLiked ? "active-like" : "")" @onclick="() => HandleInteraction(true)">
                        <span class="action-icon">👍</span>
                        <span class="action-count">@currentNews.Likes</span>
                    </button>
                    <button class="btn-action btn-dislike @(hasDisliked ? "active-dislike" : "")" @onclick="() => HandleInteraction(false)">
                        <span class="action-icon">👎</span>
                        <span class="action-count">@currentNews.Dislikes</span>
                    </button>
                </div>
                
                <button class="btn-action btn-share" @onclick="ShareArticle">
                    <span class="action-icon">⤴</span> Share
                </button>
            </div>

            <section class="comments-section">
                <h3 class="comments-heading">Comments</h3>

                @if (!sessionService.IsAuthenticated)
                {
                    <p class="comments-login-hint">
                        <a href="/login">Sign in</a> to leave a comment.
                    </p>
                }
                else
                {
                    <div class="comment-form">
                        <textarea class="comment-input" maxlength="500" rows="3" placeholder="Write a comment..." @bind="newCommentText"></textarea>
                        <button class="btn-submit-comment" disabled="@isSubmittingComment" @onclick="SubmitComment">Post comment</button>
                    </div>
                }

                @if (commentError != null)
                {
                    <p class="comment-error">@commentError</p>
                }

                <ul class="comments-list">
                    @foreach (var c in comments)
                    {
                        <li class="comment-item">
                            <span class="comment-author">@(c.User?.Username ?? "User")</span>
                            <span class="comment-date">@c.CreatedAt.ToString("MMM d, yyyy HH:mm")</span>
                            <p class="comment-body">@c.CommentText</p>
                        </li>
                    }
                </ul>
            </section>
        </article>

        <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
            <a href="/" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                <span>Home</span>
            </a>
            <a href="/just-for-you" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
                <span>For You</span>
            </a>
            <a href="/search" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C8.01 14 6 11.99 6 9.5S8.01 5 10.5 5 15 7.01 15 9.5 12.99 14 10.5 14z" /></svg>
                <span>Search</span>
            </a>
            <a href="/user-settings" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                <span>Settings</span>
            </a>
        </nav>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private News? currentNews;
    private bool isLoading = true;
    private bool hasLiked;
    private bool hasDisliked;
    private readonly Stopwatch readingTimer = new();
    private Timer? readingInterestTimer;
    private DotNetObjectReference<NewsDetails>? dotNetRef;
    private string? heroImageUrl;
    private List<NewsComment> comments = new();
    private string newCommentText = string.Empty;
    private bool isSubmittingComment;
    private string? commentError;
    private bool scrollInterestRegistered;
    private bool timerInterestRegistered;
    private bool isExtractingFullBodyText;
    private string? fullBodyError;

    protected override async Task OnInitializedAsync()
    {
        await sessionService.InitializeAsync();
        
        isLoading = true;
        currentNews = await DbContext.News
            .Include(n => n.Tag)
            .Include(n => n.DetailNews)
            .FirstOrDefaultAsync(n => n.IdNews == Id);

        if (currentNews != null)
        {
            heroImageUrl = ExtractImageUrl(currentNews.DetailNews?.Context);

            // Older records can predate full-body extraction. Backfill the article
            // through the LLM when the user opens the news, then display it below.
            if (string.IsNullOrWhiteSpace(currentNews.DetailNews?.FullBodyText) ||
                currentNews.DetailNews.FullBodyText.TrimStart().StartsWith(
                    "This is placeholder raw data gathered from analyzing the article",
                    StringComparison.OrdinalIgnoreCase))
            {
                isExtractingFullBodyText = true;
                try
                {
                    var extractedBody = await recommendationEngine.EnsureFullBodyTextAsync(Id);
                    if (!string.IsNullOrWhiteSpace(extractedBody) && currentNews.DetailNews != null)
                    {
                        currentNews.DetailNews.FullBodyText = extractedBody;
                    }
                }
                catch (Exception ex)
                {
                    fullBodyError = "The full article text could not be extracted right now.";
                    Console.Error.WriteLine($"Full article extraction failed for news {Id}: {ex}");
                }
                finally
                {
                    isExtractingFullBodyText = false;
                }
            }

            comments = await recommendationEngine.GetCommentsForNewsAsync(Id);
        }

        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || currentNews == null) return;

        readingTimer.Start();

        readingInterestTimer = new Timer(async _ =>
        {
            if (timerInterestRegistered) return;
            timerInterestRegistered = true;

            await InvokeAsync(async () =>
            {
                if (sessionService.UserId.HasValue)
                {
                    await recommendationEngine.RegisterReadingTimeAsync(
                        sessionService.UserId.Value,
                        Id,
                        timeSpentSeconds: 120);
                    await recommendationEngine.MarkNewsInterestAsync(sessionService.UserId.Value, Id);
                }
            });
        }, null, TimeSpan.FromMinutes(2), Timeout.InfiniteTimeSpan);

        dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("newsDetailScroll.registerScrollEnd", dotNetRef);
        }
        catch
        {
            // JS no disponible en prerender
        }
    }

    [JSInvokable]
    public async Task OnScrollReachedEnd()
    {
        if (scrollInterestRegistered) return;
        scrollInterestRegistered = true;

        if (sessionService.UserId.HasValue)
        {
            await recommendationEngine.MarkNewsInterestAsync(sessionService.UserId.Value, Id);
        }
    }

    private static string? ExtractImageUrl(string? context)
    {
        if (string.IsNullOrWhiteSpace(context)) return null;

        var match = Regex.Match(context, @"https?://[^\s""']+\.(?:jpg|jpeg|png|gif|webp)", RegexOptions.IgnoreCase);
        return match.Success ? match.Value : null;
    }

    private async Task GoBack()
    {
        await JS.InvokeVoidAsync("history.back");
    }
    
    private void ShareArticle()
    {
    }

    private async Task HandleInteraction(bool isLike)
    {
        if (currentNews == null) return;

        if (isLike)
        {
            if (hasLiked)
            {
                hasLiked = false;
                StateHasChanged();
                return;
            }
            hasLiked = true;
            hasDisliked = false;
        }
        else
        {
            if (hasDisliked)
            {
                hasDisliked = false;
                StateHasChanged();
                return;
            }
            hasDisliked = true;
            hasLiked = false;
        }

        if (sessionService.UserId.HasValue)
        {
            await recommendationEngine.RegisterInteractionAsync(
                userId: sessionService.UserId.Value,
                newsId: Id,
                liked: isLike,
                interested: isLike);

            currentNews = await DbContext.News
                .Include(n => n.Tag)
                .Include(n => n.DetailNews)
                .FirstOrDefaultAsync(n => n.IdNews == Id);
        }

        StateHasChanged();
    }

    private async Task SubmitComment()
    {
        commentError = null;

        if (!sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
        {
            commentError = "You must be signed in to comment.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newCommentText))
        {
            commentError = "Comment cannot be empty.";
            return;
        }

        isSubmittingComment = true;
        try
        {
            await recommendationEngine.AddCommentAsync(sessionService.UserId.Value, Id, newCommentText);
            newCommentText = string.Empty;
            comments = await recommendationEngine.GetCommentsForNewsAsync(Id);
        }
        catch
        {
            commentError = "Could not save your comment. Please try again.";
        }
        finally
        {
            isSubmittingComment = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        readingInterestTimer?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("newsDetailScroll.dispose");
        }
        catch { }

        dotNetRef?.Dispose();

        if (readingTimer.IsRunning)
        {
            readingTimer.Stop();
            var timeSpentSeconds = readingTimer.Elapsed.TotalSeconds;

            if (sessionService.UserId.HasValue && timeSpentSeconds > 3 && currentNews != null)
            {
                await recommendationEngine.RegisterReadingTimeAsync(
                    userId: sessionService.UserId.Value,
                    newsId: Id,
                    timeSpentSeconds: timeSpentSeconds);

                if (timeSpentSeconds >= 120)
                {
                    await recommendationEngine.MarkNewsInterestAsync(sessionService.UserId.Value, Id);
                }
            }
        }
    }
}