@page "/news-detail/{Id:int}"
@implements IAsyncDisposable

@using System.Diagnostics
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using Microsoft.JSInterop
@using NuctiusNow.Data
@using NuctiusNow.Services
@using NuctiusNow.Components.User_Related
@inject UserSessionService sessionService
@inject NavigationManager Navigation
@inject ApplicationDbContext DbContext
@inject RecommendationEngine recommendationEngine
@inject IJSRuntime JS

<PageTitle>News Details - NuctiusNow</PageTitle>

@if (isLoading)
{
    <div class="news-detail-page" style="display:flex; justify-content:center; align-items:center; padding-top:4rem;">
        <div class="loading-spinner"></div>
    </div>
}
else if (currentNews == null)
{
    <div class="news-detail-page" style="display:flex; justify-content:center; align-items:center; padding-top:4rem;">
        <div class="error-message">Requested news not found.</div>
    </div>
}
else
{
    <div class="news-detail-page">
        <div class="back-nav">
            <button class="btn-back" @onclick="GoBack">
                <svg viewBox="0 0 24 24" style="width:20px;height:20px;fill:currentColor;">
                    <path d="M20 11H7.83l5.59-5.59L12 4l-8 8 8 8 1.41-1.41L7.83 13H20v-2z" />
                </svg>
                Back
            </button>
        </div>

        <article class="detail-card">
            <div class="meta-info">
                <span class="category">@(currentNews.Tag?.Name ?? "General")</span>
                <span class="news-id">@((currentNews.DetailNews?.NewsDate ?? currentNews.CapturedDate).ToLocalTime().ToString("MMM d, yyyy - HH:mm"))</span>
            </div>

            <h1 class="detail-title">@(currentNews.DetailNews?.Keyword ?? "No Title Available")</h1>

            <div class="detail-source-block">
                <span class="detail-section-label">SOURCE</span>
                @if (!string.IsNullOrWhiteSpace(currentNews.Hyperlink))
                {
                    <a href="@currentNews.Hyperlink" target="_blank" rel="noopener noreferrer" class="detail-source-link">
                        <span>@GetSourceOwner(currentNews.Hyperlink)</span>
                        <span class="detail-source-url">@currentNews.Hyperlink</span>
                        <span aria-hidden="true">↗</span>
                    </a>
                }
            </div>
            <br/>
            <div class="detail-content-layout">
                @if (!string.IsNullOrWhiteSpace(heroImageUrl))
                {
                    <img src="@heroImageUrl" class="detail-img" alt="Article image" />
                }

                <div class="detail-text">
                    <section class="summary-section detail-reading-section">
                        <div class="detail-section-label">AI SUMMARY</div>
                        @if (!string.IsNullOrWhiteSpace(currentNews.DetailNews?.AiSummary))
                        {
                            <p>@currentNews.DetailNews.AiSummary</p>
                        }
                        else
                        {
                            <p><i>The AI summary is not available right now.</i></p>
                        }
                    </section>

                    <section class="full-article-section detail-reading-section">
                        <div class="detail-section-label">AI GENERATED ARTICLE</div>
                        @if (isGeneratingArticle)
                        {
                            <div class="article-loading-state">
                                <div class="loading-spinner"></div>
                                <p>The AI is reading the available news sources and writing an original explanation…</p>
                            </div>
                        }
                        else if (currentNews.DetailNews?.BodySource == "AiGenerated" &&
                                 !string.IsNullOrWhiteSpace(currentNews.DetailNews.FullBodyText))
                        {
                            <div class="full-article-body">@currentNews.DetailNews.FullBodyText</div>
                        }
                        else if (!string.IsNullOrWhiteSpace(fullBodyError))
                        {
                            <p><i>@fullBodyError</i></p>
                        }
                        else
                        {
                            <p><i>The AI generated article is not available right now.</i></p>
                        }
                    </section>
                </div>
            </div>

            <div class="article-actions-bar">
                <div class="reactions-group">
                    <button class="btn-action btn-like @(hasLiked ? "active-like" : "")"
                            @onclick="() => HandleInteraction(true)"
                            disabled="@(!sessionService.IsAuthenticated)">
                        <span class="action-icon">👍</span>
                        <span class="action-count">@currentNews.Likes</span>
                    </button>
                    <button class="btn-action btn-dislike @(hasDisliked ? "active-dislike" : "")"
                            @onclick="() => HandleInteraction(false)"
                            disabled="@(!sessionService.IsAuthenticated)">
                        <span class="action-icon">👎</span>
                        <span class="action-count">@currentNews.Dislikes</span>
                    </button>
                </div>
                @if (!sessionService.IsAuthenticated)
                {
                    <span class="comments-login-hint"><a href="/login">Sign in</a> to react.</span>
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(reactionError))
            {
                <p class="comment-error">@reactionError</p>
            }

            <section class="comments-section">
                <h3 class="comments-heading">Comments</h3>

                @if (!sessionService.IsAuthenticated)
                {
                    <p class="comments-login-hint">
                        <a href="/login">Sign in</a> to leave a comment.
                    </p>
                }
                else
                {
                    <div class="comment-form">
                        <textarea class="comment-input"
                                  maxlength="500"
                                  rows="3"
                                  placeholder="Write a comment..."
                                  @bind="newCommentText"></textarea>
                        <button class="btn-submit-comment"
                                disabled="@isSubmittingComment"
                                @onclick="SubmitComment">
                            Post comment
                        </button>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(commentError))
                {
                    <p class="comment-error">@commentError</p>
                }

                <ul class="comments-list">
                    @foreach (var comment in comments)
                    {
                        <li class="comment-item">
                            <span class="comment-author">@(comment.User?.Username ?? "User")</span>
                            <span class="comment-date">@comment.CreatedAt.ToLocalTime().ToString("MMM d, yyyy HH:mm")</span>
                            <p class="comment-body">@comment.CommentText</p>
                        </li>
                    }
                </ul>
            </section>

            @if (additionalSources.Count > 0)
            {
                <section class="additional-sources-section">
                    <div class="detail-section-label">ADDITIONAL SOURCES USED BY THE AI</div>
                    <p class="additional-sources-intro">These independent news sources supplied factual material for the original NuctiusNow article.</p>
                    <div class="additional-source-list">
                        @foreach (var source in additionalSources)
                        {
                            <a href="@source.Url" class="additional-source-item" target="_blank" rel="noopener noreferrer">
                                <span class="additional-source-owner">@source.Owner</span>
                                <span class="additional-source-title">@source.Title</span>
                                <span class="additional-source-arrow" aria-hidden="true">↗</span>
                            </a>
                        }
                    </div>
                </section>
            }
        </article>

        <nav class="bottom-nav" role="navigation" aria-label="Bottom navigation">
            <a href="/" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" /></svg>
                <span>Home</span>
            </a>
            <a href="/just-for-you" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 21.593c-5.63-5.539-11-10.297-11-14.402 0-3.791 3.068-5.191 5.281-5.191 1.312 0 4.151.501 5.719 4.457 1.59-3.968 4.464-4.447 5.726-4.447 2.54 0 5.274 1.621 5.274 5.181 0 4.069-5.136 8.625-11 14.402z" /></svg>
                <span>For You</span>
            </a>
            <a href="/search" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M15.5 14h-.79l-.28-.27A6.471 6.471 0 0016 9.5 6.5 6.5 0 109.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5z" /></svg>
                <span>Search</span>
            </a>
            <a href="/user-settings" class="bottom-nav-item">
                <svg viewBox="0 0 24 24" class="bnav-icon" aria-hidden="true"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z" /></svg>
                <span>Settings</span>
            </a>
        </nav>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private News? currentNews;
    private bool isLoading = true;
    private bool hasLiked;
    private bool hasDisliked;
    private readonly Stopwatch readingTimer = new();
    private Timer? readingInterestTimer;
    private DotNetObjectReference<NewsDetails>? dotNetRef;
    private string? heroImageUrl;
    private List<NewsComment> comments = new();
    private string newCommentText = string.Empty;
    private bool isSubmittingComment;
    private string? commentError;
    private string? reactionError;
    private bool scrollInterestRegistered;
    private bool timerInterestRegistered;
    private bool isGeneratingArticle;
    private string? fullBodyError;
    private List<AdditionalSource> additionalSources = new();

    protected override async Task OnInitializedAsync()
    {
        await sessionService.InitializeAsync();

        currentNews = await DbContext.News
            .Include(n => n.Tag)
            .Include(n => n.DetailNews)
            .FirstOrDefaultAsync(n => n.IdNews == Id);

        if (currentNews == null)
        {
            isLoading = false;
            return;
        }

        heroImageUrl = currentNews.DetailNews?.ImageUrl;
        LoadAdditionalSources();

        // Images are cached permanently once found. Existing cached data therefore
        // renders immediately on subsequent visits.
        if (string.IsNullOrWhiteSpace(heroImageUrl))
        {
            try
            {
                heroImageUrl = await recommendationEngine.EnsureNewsImageAsync(Id);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"News image enrichment failed for {Id}: {ex}");
            }
        }

        if (sessionService.IsAuthenticated && sessionService.UserId.HasValue)
        {
            try
            {
                var reaction = await recommendationEngine.GetUserReactionAsync(
                    sessionService.UserId.Value,
                    Id);

                hasLiked = reaction == 1;
                hasDisliked = reaction == -1;

                // Direct opens (for example from a bookmark or URL) still register the
                // article as viewed; Home/Search/For You already register the stronger click signal.
                await recommendationEngine.RegisterNewsViewAsync(
                    sessionService.UserId.Value,
                    Id);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"News interaction initialization failed for {Id}: {ex}");
            }
        }

        var hasCachedArticle = currentNews.DetailNews?.BodySource == "AiGenerated" &&
                               !string.IsNullOrWhiteSpace(currentNews.DetailNews.FullBodyText);
        var hasCachedSummary = !string.IsNullOrWhiteSpace(currentNews.DetailNews?.AiSummary);

        if (!hasCachedArticle || !hasCachedSummary)
        {
            isGeneratingArticle = true;
            try
            {
                var generated = await recommendationEngine.EnsureAiGeneratedArticleAsync(Id);

                // The recommendation engine stores both the original NuctiusNow article
                // and the AI summary. Reload once so the cached values are what the UI renders.
                if (!string.IsNullOrWhiteSpace(generated) || !hasCachedSummary)
                {
                    currentNews = await DbContext.News
                        .Include(n => n.Tag)
                        .Include(n => n.DetailNews)
                        .FirstOrDefaultAsync(n => n.IdNews == Id);
                }
            }
            catch (OperationCanceledException)
            {
                throw;
            }
            catch (Exception ex)
            {
                fullBodyError = "The AI could not create an original article from the available news evidence right now.";
                Console.Error.WriteLine($"AI article generation failed for news {Id}: {ex}");
            }
            finally
            {
                isGeneratingArticle = false;
                LoadAdditionalSources();
            }
        }

        comments = await recommendationEngine.GetCommentsForNewsAsync(Id);
        isLoading = false;
    }

    private void LoadAdditionalSources()
    {
        additionalSources = new List<AdditionalSource>();
        var json = currentNews?.DetailNews?.AdditionalSourcesJson;
        if (string.IsNullOrWhiteSpace(json))
            return;

        try
        {
            var parsed = JsonSerializer.Deserialize<List<AdditionalSource>>(
                json,
                new JsonSerializerOptions { PropertyNameCaseInsensitive = true });

            if (parsed != null)
            {
                additionalSources = parsed
                    .Where(x => !string.IsNullOrWhiteSpace(x.Url))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Could not parse additional sources for news {Id}: {ex.Message}");
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || currentNews == null)
            return;

        readingTimer.Start();

        if (sessionService.IsAuthenticated)
        {
            readingInterestTimer = new Timer(async _ =>
            {
                if (timerInterestRegistered)
                    return;

                timerInterestRegistered = true;

                try
                {
                    await InvokeAsync(async () =>
                    {
                        if (sessionService.UserId.HasValue)
                        {
                            await recommendationEngine.RegisterReadingTimeAsync(
                                sessionService.UserId.Value,
                                Id,
                                timeSpentSeconds: 120);
                        }
                    });
                }
                catch (Exception ex)
                {
                    Console.Error.WriteLine($"Reading-time tracking failed for news {Id}: {ex.Message}");
                }
            }, null, TimeSpan.FromMinutes(2), Timeout.InfiniteTimeSpan);
        }

        dotNetRef = DotNetObjectReference.Create(this);
        try
        {
            await JS.InvokeVoidAsync("newsDetailScroll.registerScrollEnd", dotNetRef);
        }
        catch
        {
            // Scroll tracking is optional; it must not break the article page.
        }
    }

    [JSInvokable]
    public async Task OnScrollReachedEnd()
    {
        if (scrollInterestRegistered)
            return;

        scrollInterestRegistered = true;

        if (sessionService.UserId.HasValue)
        {
            try
            {
                await recommendationEngine.MarkNewsInterestAsync(
                    sessionService.UserId.Value,
                    Id);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"Scroll-interest tracking failed for news {Id}: {ex.Message}");
            }
        }
    }

    private static string GetSourceOwner(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
            return "Source";

        var host = uri.Host.ToLowerInvariant();
        if (host.StartsWith("www."))
            host = host[4..];

        return host switch
        {
            "clarin.com" => "Clarín",
            "cronica.com.ar" => "Crónica",
            "perfil.com" => "Perfil",
            "lanacion.com.ar" => "La Nación",
            "infobae.com" => "Infobae",
            "pagina12.com.ar" => "Página/12",
            "tn.com.ar" => "TN",
            "bbc.com" or "bbc.co.uk" => "BBC",
            "reuters.com" => "Reuters",
            "apnews.com" => "AP",
            "nytimes.com" => "The New York Times",
            "theguardian.com" => "The Guardian",
            _ => host
        };
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");

    private async Task HandleInteraction(bool isLike)
    {
        reactionError = null;

        if (currentNews == null ||
            !sessionService.IsAuthenticated ||
            !sessionService.UserId.HasValue)
        {
            return;
        }

        try
        {
            await recommendationEngine.RegisterInteractionAsync(
                sessionService.UserId.Value,
                Id,
                liked: isLike,
                interested: isLike);

            var reaction = await recommendationEngine.GetUserReactionAsync(
                sessionService.UserId.Value,
                Id);

            hasLiked = reaction == 1;
            hasDisliked = reaction == -1;

            currentNews = await DbContext.News
                .Include(n => n.Tag)
                .Include(n => n.DetailNews)
                .FirstOrDefaultAsync(n => n.IdNews == Id);
        }
        catch (Exception ex)
        {
            reactionError = "Could not save your reaction. Please try again.";
            Console.Error.WriteLine($"Reaction update failed for news {Id}: {ex}");
        }
    }

    private async Task SubmitComment()
    {
        commentError = null;

        if (!sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
        {
            commentError = "You must be signed in to comment.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newCommentText))
        {
            commentError = "Comment cannot be empty.";
            return;
        }

        isSubmittingComment = true;
        try
        {
            await recommendationEngine.AddCommentAsync(
                sessionService.UserId.Value,
                Id,
                newCommentText);

            newCommentText = string.Empty;
            comments = await recommendationEngine.GetCommentsForNewsAsync(Id);
        }
        catch
        {
            commentError = "Could not save your comment. Please try again.";
        }
        finally
        {
            isSubmittingComment = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        readingInterestTimer?.Dispose();

        try
        {
            await JS.InvokeVoidAsync("newsDetailScroll.dispose");
        }
        catch
        {
            // Ignore JS teardown errors when the circuit is already ending.
        }

        dotNetRef?.Dispose();

        if (readingTimer.IsRunning)
        {
            readingTimer.Stop();
            var timeSpentSeconds = readingTimer.Elapsed.TotalSeconds;

            if (sessionService.UserId.HasValue &&
                currentNews != null &&
                timeSpentSeconds > 3 &&
                !(timerInterestRegistered && timeSpentSeconds >= 120))
            {
                try
                {
                    await recommendationEngine.RegisterReadingTimeAsync(
                        sessionService.UserId.Value,
                        Id,
                        timeSpentSeconds);
                }
                catch
                {
                    // Tracking must never prevent page disposal.
                }
            }
        }
    }

    private sealed class AdditionalSource
    {
        public string Title { get; set; } = string.Empty;
        public string Url { get; set; } = string.Empty;
        public string Owner { get; set; } = "Source";
    }
}
