@page "/noticia-detalle/{Id:int}"
@page "/news-detail/{Id:int}"
@rendermode InteractiveServer
@inject UserSessionService sessionService
@inject NavigationManager Navigation

<PageTitle>News Detail - NuctiusNow</PageTitle>

<div class="detail-page-container">

    <div class="back-nav">
        <NavLink href="just-for-you" class="btn-back">⬅ Back to Just For You</NavLink>
    </div>

    <article class="detail-card">
        <div class="meta-info">
            <span class="category">@Category</span>
            <span class="news-id">News #: #@Id</span>
        </div>

        <h1 class="detail-title">@Title</h1>

        <div class="detail-content-layout">
            <img src="@ImageUrl" class="detail-img" alt="News Image Full" />

            <div class="detail-text">
                <h3>Main Summary</h3>
                <p class="body-featured">@Content</p>

                <h3>Full Article Body</h3>
                <p>Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat. Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla pariatur. Excepteur sint occaecat cupidatat non proident, sunt in culpa qui officia deserunt mollit anim id est laborum.</p>
                <p>Adding contextual information and simulated content for the full article body displayed in premium portals.</p>
            </div>
        </div>

        <div class="article-actions-bar">
            <div class="reactions-group">
                <button class="btn-action btn-like @(hasLiked ? "active-like" : "")" @onclick="HandleLike">
                    <span class="action-icon">👍</span>
                    <span class="action-count">@likeCount</span>
                </button>

                <button class="btn-action btn-dislike @(hasDisliked ? "active-dislike" : "")" @onclick="HandleDislike">
                    <span class="action-icon">👎</span>
                </button>
            </div>

            <button class="btn-action btn-share" @onclick="HandleShare">
                <span class="action-icon">📨</span> Share
            </button>
        </div>
    </article>

</div>

@code {
    [Parameter] public int Id { get; set; }

    private string Category { get; set; } = "Loading...";
    private string Title { get; set; } = "Loading...";
    private string Content { get; set; } = "";
    private string ImageUrl { get; set; } = "https://picsum.photos/400/300";

    // Interaction state
    private int likeCount = 42;
    private bool hasLiked = false;
    private bool hasDisliked = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await sessionService.InitializeAsync();
        if (!sessionService.IsAuthenticated)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (Id == 1) { Category = "Technology"; Title = "NVIDIA: SPARK PROCESSOR"; ImageUrl = "https://picsum.photos/id/0/400/300"; }
        else if (Id == 2) { Category = "Sports"; Title = "WORLD CUP: URUGUAY ELIMINATED"; ImageUrl = "https://picsum.photos/id/73/400/300"; }
        else if (Id == 3) { Category = "Weather"; Title = "ARGENTINA: RAINING ON MONDAY"; ImageUrl = "https://picsum.photos/id/401/400/300"; }
        else { Category = "Technology"; Title = "AMD: THEIR LAST INNOVATION"; ImageUrl = "https://picsum.photos/id/160/400/300"; }

        Content = "[This is a placeholder summary generated for debugging purposes.]";
    }

    private void HandleLike()
    {
        if (hasLiked)
        {
            likeCount--;
            hasLiked = false;
        }
        else
        {
            likeCount++;
            hasLiked = true;
            if (hasDisliked) hasDisliked = false; // clear dislike if it was active
        }
    }

    private void HandleDislike()
    {
        if (hasDisliked)
        {
            hasDisliked = false;
        }
        else
        {
            hasDisliked = true;
            if (hasLiked)
            {
                likeCount--;
                hasLiked = false; // clear like if it was active
            }
        }
    }

    private void HandleShare()
    {
        Console.WriteLine($"News link #{Id} copied to clipboard.");
    }
}
