@using NuctiusNow.Services
@page "/user-settings"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Web
@inject ThemeState ThemeState
@inject AuthService authService
@inject IJSRuntime JSRuntime
@inject UserSessionService sessionService
@inject NavigationManager Navigation
@inject EmailVerificationService EmailVerification
@inject UserBlockedSourceService BlockedSourceService

<PageTitle>User Settings - NuctiusNow</PageTitle>

@if (!userLoaded)
{
    <div class="settings-page settings-state-page">
        <div class="settings-state-card">
            <span class="section-kicker">NUCTIUSNOW / PROFILE</span>
            <h1>Loading your profile…</h1>
            <div class="loading-spinner"></div>
        </div>
    </div>
}
else
{
    <div class="settings-page">
        <header class="settings-hero">
            <div>
                <span class="section-kicker">NUCTIUSNOW / PROFILE</span>
                <h1>USER SETTINGS</h1>
                <p>Edit your account, recommendation preferences and visual experience. Profile changes are limited to one successful update every three hours.</p>
            </div>
            <button class="settings-back" @onclick="GoBack">← Back</button>
        </header>

        @if (!string.IsNullOrWhiteSpace(saveMessage))
        {
            <div class="settings-alert @(saveSucceeded ? "success" : "error")">
                @saveMessage
            </div>
        }

        <section class="settings-grid">
            <article class="settings-panel profile-panel">
                <div class="settings-panel-heading">
                    <div>
                        <span class="panel-kicker">ACCOUNT</span>
                        <h2>Personal information</h2>
                    </div>
                    <span class="settings-lock-badge @(profileUpdateLocked ? "locked" : "open")">
                        @(profileUpdateLocked ? "LOCKED" : "EDITABLE")
                    </span>
                </div>

                @if (profileUpdateLocked)
                {
                    <div class="cooldown-banner">
                        <strong>Profile editing is temporarily locked.</strong>
                        <span>Next update: @nextAvailableAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                    </div>
                }

                <div class="settings-form-grid">
                    <label class="settings-field">
                        <span>Username</span>
                        <input type="text" @bind="userModel.Username" disabled="@profileUpdateLocked" autocomplete="username" maxlength="60" />
                    </label>

                    <label class="settings-field">
                        <span>Email</span>
                        <input type="email" @bind="userModel.Email" disabled="@profileUpdateLocked" autocomplete="email" maxlength="160" />
                    </label>

                    <label class="settings-field">
                        <span>New password</span>
                        <input type="password" @bind="userModel.Password" disabled="@profileUpdateLocked" autocomplete="new-password" placeholder="Leave blank to keep current password" />
                    </label>

                    <label class="settings-field">
                        <span>Confirm password</span>
                        <input type="password" @bind="userModel.ConfirmPassword" disabled="@profileUpdateLocked" autocomplete="new-password" placeholder="Repeat new password" />
                    </label>

                    <label class="settings-field">
                        <span>Birthday</span>
                        <input type="date" @bind="userModel.Birthday" @bind:format="yyyy-MM-dd" disabled="@profileUpdateLocked" />
                    </label>

                    <label class="settings-field">
                        <span>Language</span>
                        <select @bind="userModel.Language" disabled="@profileUpdateLocked">
                            <option value="English">English</option>
                            <option value="Spanish">Spanish</option>
                        </select>
                    </label>
                </div>
            </article>

            <article class="settings-panel preference-panel">
                <div class="settings-panel-heading">
                    <div>
                        <span class="panel-kicker">RECOMMENDATION SIGNALS</span>
                        <h2>Your preferences</h2>
                    </div>
                    <button class="add-preference-button" @onclick="OpenPreferenceModal" disabled="@profileUpdateLocked">+</button>
                </div>

                <p class="settings-description">
                    These topics are passed to NuctiusNow's recommendation engine together with your site interactions.
                </p>

                <div class="preference-chip-list">
                    @foreach (var pref in userModel.Preferences)
                    {
                        <span class="preference-chip" @key="pref">
                            <span>@pref</span>
                            <button type="button" @onclick="() => RemovePreference(pref)" disabled="@profileUpdateLocked" aria-label="Remove @pref">×</button>
                        </span>
                    }

                    @if (userModel.Preferences.Count == 0)
                    {
                        <span class="empty-preferences">No preferences configured yet.</span>
                    }
                </div>
            </article>

            <article class="settings-panel source-panel">
                <div class="settings-panel-heading">
                    <div>
                        <span class="panel-kicker">AI SOURCE CONTROL</span>
                        <h2>Blocked news sources</h2>
                    </div>
                    <span class="current-theme">@blockedSourceDomains.Count selected</span>
                </div>

                <p class="settings-description">
                    Add domains that NuctiusNow's news search must exclude. Use only the domain, for example
                    <strong>example.com</strong>. This setting is independent from the three-hour profile update cooldown.
                </p>

                <div class="source-filter-input-row">
                    <input type="text"
                           @bind="newBlockedSource"
                           @bind:event="oninput"
                           @onkeyup="HandleBlockedSourceKeyUp"
                           placeholder="e.g. example.com"
                           maxlength="160" />
                    <button type="button"
                            class="add-preference-button"
                            @onclick="AddBlockedSource"
                            title="Add blocked source">+</button>
                </div>

                <div class="source-chip-list">
                    @foreach (var source in blockedSourceDomains)
                    {
                        <span class="source-chip" @key="source">
                            <span>@source</span>
                            <button type="button"
                                    @onclick="() => RemoveBlockedSource(source)"
                                    aria-label="Remove @source">×</button>
                        </span>
                    }

                    @if (blockedSourceDomains.Count == 0)
                    {
                        <span class="empty-preferences">No source exclusions configured.</span>
                    }
                </div>

                @if (!string.IsNullOrWhiteSpace(sourceFilterMessage))
                {
                    <div class="settings-alert @(sourceFilterSaveSucceeded ? "success" : "error")">
                        @sourceFilterMessage
                    </div>
                }

                <div class="source-filter-actions">
                    <button type="button"
                            class="settings-primary-button"
                            @onclick="SaveBlockedSources"
                            disabled="@isSavingBlockedSources">
                        @(isSavingBlockedSources ? "Saving…" : "Save source filters")
                    </button>
                </div>
            </article>

            <article class="settings-panel theme-panel">
                <div class="settings-panel-heading">
                    <div>
                        <span class="panel-kicker">INTERFACE</span>
                        <h2>Theme</h2>
                    </div>
                    <span class="current-theme">@ThemeState.CurrentTheme</span>
                </div>

                <p class="settings-description">Choose the visual theme for the portal. Theme changes apply across NuctiusNow immediately and do not consume your three-hour profile update.</p>

                <div class="theme-options">
                    @foreach (var theme in ThemeOptions)
                    {
                        <button type="button"
                                class="theme-option @(ThemeState.CurrentTheme.Equals(theme, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                                @onclick="() => SelectTheme(theme)">
                            <span class="theme-preview theme-preview-@theme"></span>
                            <span>@CultureTitle(theme)</span>
                        </button>
                    }
                </div>
            </article>
        </section>

        <div class="settings-actions-bar">
            <button class="settings-secondary-button" @onclick="HandleLogout" disabled="@isLoggingOut">Logout</button>
            <button class="settings-primary-button" @onclick="SaveChanges" disabled="@(isSaving || profileUpdateLocked)">
                @(isSaving ? "Saving…" : "Apply changes")
            </button>
        </div>
    </div>
}

@if (isPrefModalOpen)
{
    <div class="settings-modal-backdrop" @onclick="ClosePreferenceModal">
        <section class="settings-modal" @onclick:stopPropagation>
            <div class="settings-modal-heading">
                <div>
                    <span class="panel-kicker">PERSONALIZATION</span>
                    <h2>Add preference</h2>
                </div>
                <button type="button" class="modal-close" @onclick="ClosePreferenceModal">×</button>
            </div>

            <label class="settings-field">
                <span>What are you interested in?</span>
                <input type="text"
                       @bind="newPreferenceInput"
                       @bind:event="oninput"
                       @onkeyup="HandlePrefKeyUp"
                       placeholder="e.g. Artificial Intelligence, Corsair, Athletics"
                       maxlength="50" />
            </label>

            @if (!string.IsNullOrWhiteSpace(validationMessage))
            {
                <div class="settings-alert error">@validationMessage</div>
            }

            <div class="settings-modal-actions">
                <button class="settings-secondary-button" @onclick="ClosePreferenceModal">Cancel</button>
                <button class="settings-primary-button" @onclick="SavePreference">Add preference</button>
            </div>
        </section>
    </div>
}

@code {
    private static readonly string[] ThemeOptions = { "dark", "light", "retro", "office" };

    private SettingsFields userModel = new();
    private bool userLoaded;
    private bool isSaving;
    private bool isLoggingOut;
    private bool isPrefModalOpen;
    private bool saveSucceeded;
    private bool profileUpdateLocked;
    private DateTime? nextAvailableAt;
    private string saveMessage = string.Empty;
    private string validationMessage = string.Empty;
    private string newPreferenceInput = string.Empty;
    private string newBlockedSource = string.Empty;
    private List<string> blockedSourceDomains = new();
    private bool isSavingBlockedSources;
    private bool sourceFilterSaveSucceeded;
    private string sourceFilterMessage = string.Empty;

    private readonly HashSet<string> blocklist = new(StringComparer.OrdinalIgnoreCase)
    {
        "mierda", "puto", "puta", "carajo", "pelotudo", "boludo", "concha", "forro", "culiao"
    };

    protected override async Task OnInitializedAsync()
    {
        await sessionService.InitializeAsync();

        if (!sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        var user = await authService.GetUserByIdAsync(sessionService.UserId.Value);
        if (user == null)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        userModel = new SettingsFields
        {
            Email = user.Email,
            Username = user.Username,
            Birthday = user.Birthday == default ? DateTime.Today : user.Birthday.Date,
            Language = user.Language.Equals("es", StringComparison.OrdinalIgnoreCase) ||
                        user.Language.Equals("Spanish", StringComparison.OrdinalIgnoreCase)
                ? "Spanish"
                : "English",
            Password = string.Empty,
            ConfirmPassword = string.Empty,
            Preferences = await authService.GetUserPreferencesAsync(sessionService.UserId.Value)
        };

        blockedSourceDomains = await BlockedSourceService.GetAsync(sessionService.UserId.Value);

        await RefreshProfileUpdateStatusAsync();
        userLoaded = true;
    }

    private async Task RefreshProfileUpdateStatusAsync()
    {
        if (!sessionService.UserId.HasValue)
            return;

        var status = await authService.GetProfileUpdateStatusAsync(sessionService.UserId.Value);
        profileUpdateLocked = !status.CanUpdate;
        nextAvailableAt = status.NextAvailableAt;
    }

    private async Task GoBack() => await JSRuntime.InvokeVoidAsync("history.back");

    private async Task SelectTheme(string theme)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "selectedTheme", theme);
        ThemeState.SetTheme(theme);
    }

    private static string CultureTitle(string theme) =>
        string.IsNullOrWhiteSpace(theme) ? theme : char.ToUpperInvariant(theme[0]) + theme[1..];

    private void OpenPreferenceModal()
    {
        if (profileUpdateLocked)
            return;
        validationMessage = string.Empty;
        newPreferenceInput = string.Empty;
        isPrefModalOpen = true;
    }

    private void ClosePreferenceModal() => isPrefModalOpen = false;

    private void SavePreference()
    {
        var value = newPreferenceInput.Trim();
        validationMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            validationMessage = "The preference cannot be empty.";
            return;
        }

        if (userModel.Preferences.Any(p => p.Equals(value, StringComparison.OrdinalIgnoreCase)))
        {
            validationMessage = "This preference already exists.";
            return;
        }

        if (blocklist.Any(bad => value.Contains(bad, StringComparison.OrdinalIgnoreCase)))
        {
            validationMessage = "Explicit language or insults are not allowed.";
            return;
        }

        userModel.Preferences.Add(value);
        isPrefModalOpen = false;
    }

    private void HandlePrefKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            SavePreference();
    }

    private void RemovePreference(string target)
    {
        if (!profileUpdateLocked)
            userModel.Preferences.Remove(target);
    }


    private void HandleBlockedSourceKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            AddBlockedSource();
    }

    private void AddBlockedSource()
    {
        var value = NormalizeBlockedSourceInput(newBlockedSource);
        sourceFilterMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(value))
        {
            sourceFilterMessage = "Enter a valid domain such as example.com.";
            sourceFilterSaveSucceeded = false;
            return;
        }

        if (!blockedSourceDomains.Contains(value, StringComparer.OrdinalIgnoreCase))
            blockedSourceDomains.Add(value);

        blockedSourceDomains = blockedSourceDomains
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(x => x, StringComparer.OrdinalIgnoreCase)
            .Take(50)
            .ToList();

        newBlockedSource = string.Empty;
    }

    private void RemoveBlockedSource(string source)
    {
        blockedSourceDomains.RemoveAll(
            x => string.Equals(x, source, StringComparison.OrdinalIgnoreCase));
    }

    private static string NormalizeBlockedSourceInput(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return string.Empty;

        var input = value.Trim();

        if (!input.Contains("://", StringComparison.Ordinal))
            input = "https://" + input;

        if (!Uri.TryCreate(input, UriKind.Absolute, out var uri))
            return string.Empty;

        var host = uri.Host.Trim().ToLowerInvariant();
        if (host.StartsWith("www.", StringComparison.Ordinal))
            host = host[4..];

        return host.Contains('.', StringComparison.Ordinal) && host.Length >= 3
            ? host
            : string.Empty;
    }

    private async Task SaveBlockedSources()
    {
        if (isSavingBlockedSources || !sessionService.UserId.HasValue)
            return;

        isSavingBlockedSources = true;
        sourceFilterMessage = string.Empty;
        sourceFilterSaveSucceeded = false;

        try
        {
            var result = await BlockedSourceService.ReplaceAsync(
                sessionService.UserId.Value,
                blockedSourceDomains);

            sourceFilterSaveSucceeded = result.Success;
            sourceFilterMessage = result.Message;
        }
        catch (Exception ex)
        {
            sourceFilterMessage = "Could not save source filters: " + ex.Message;
        }
        finally
        {
            isSavingBlockedSources = false;
        }
    }

    private async Task SaveChanges()
    {
        await sessionService.InitializeAsync();
        if (isSaving || !userLoaded || profileUpdateLocked || !sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
            return;

        saveMessage = string.Empty;
        saveSucceeded = false;

        if (!string.IsNullOrWhiteSpace(userModel.Password) &&
            !string.Equals(userModel.Password, userModel.ConfirmPassword, StringComparison.Ordinal))
        {
            saveMessage = "The new password and confirmation do not match.";
            return;
        }

        isSaving = true;
        try
        {
            var result = await authService.UpdateProfileAsync(
                sessionService.UserId.Value,
                userModel.Username,
                userModel.Email,
                userModel.Birthday,
                userModel.Language,
                string.IsNullOrWhiteSpace(userModel.Password) ? null : userModel.Password,
                userModel.Preferences);

            saveSucceeded = result.Success;
            saveMessage = result.Message;
            nextAvailableAt = result.NextAvailableAt;
            profileUpdateLocked = !result.Success && result.NextAvailableAt.HasValue;

            if (result.Success)
            {
                if (result.RequiresEmailVerification)
                {
                    var userId = sessionService.UserId.Value;
                    await sessionService.ClearAsync();
                    try { await EmailVerification.SendActivationEmailAsync(userId); }
                    catch { /* The pending page supports resending after SMTP is restored. */ }
                    Navigation.NavigateTo($"/email-verification-pending?email={Uri.EscapeDataString(userModel.Email.Trim())}");
                    return;
                }
                userModel.Password = string.Empty;
                userModel.ConfirmPassword = string.Empty;
                await sessionService.SetUserAsync(sessionService.UserId.Value, userModel.Username);
                await RefreshProfileUpdateStatusAsync();
            }
        }
        catch (Exception ex)
        {
            saveMessage = "Could not save profile changes: " + ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleLogout()
    {
        if (isLoggingOut)
            return;

        isLoggingOut = true;
        try
        {
            await sessionService.ClearAsync();
            Navigation.NavigateTo("/login", true);
        }
        finally
        {
            isLoggingOut = false;
        }
    }

    private sealed class SettingsFields
    {
        public string Email { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
        public DateTime Birthday { get; set; } = DateTime.Today;
        public string Language { get; set; } = "English";
        public List<string> Preferences { get; set; } = new();
    }
}
