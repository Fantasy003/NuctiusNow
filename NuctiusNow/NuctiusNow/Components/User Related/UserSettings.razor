@page "/user-settings"
@rendermode InteractiveServer
@inject ThemeState ThemeState
@inject AuthService authService
@inject IJSRuntime JSRuntime
@inject UserSessionService sessionService
@inject NavigationManager Navigation

<PageTitle>User Settings - NuctiusNow</PageTitle>

@if (!userLoaded)
{
    <div class="loading-spinner" style="text-align:center; padding: 2rem; color: white;">
        Loading profile...
    </div>
}
else
{
    <div class="settings-page-container">

        <div class="settings-card">

            <div class="avatar-container">
                <div class="avatar-circle">
                    <svg viewBox="0 0 24 24" class="avatar-icon">
                        <path d="M12,12A5,5 0 1,1 17,7A5,5 0 0,1 12,12M12,14c4.42,0 8,1.79 8,4v2H4v-2c0-2.21 3.58-4 8-4Z" />
                    </svg>
                </div>
            </div>

            <h1 class="main-title">USER SETTINGS</h1>

            @if (!string.IsNullOrEmpty(saveMessage))
            {
                <div class="status-alert">
                    @saveMessage
                </div>
            }

            <div class="settings-form">
                <div class="form-group">
                    <label>Username</label>
                    <div class="input-wrapper">
                        <input type="text" @bind="userModel.Username" class="dark-input" />
                        <svg class="input-icon" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.18L3,17.25Z" /></svg>
                    </div>
                </div>

                <div class="form-group">
                    <label>Email</label>
                    <div class="input-wrapper">
                        <input type="email" @bind="userModel.Email" class="dark-input" />
                        <svg class="input-icon" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.18L3,17.25Z" /></svg>
                    </div>
                </div>

                <div class="form-group">
                    <label>Password</label>
                    <div class="input-wrapper">
                        <input type="password" @bind="userModel.Password" class="dark-input" />
                        <svg class="input-icon" viewBox="0 0 24 24"><path d="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.07,6.18L3,17.25Z" /></svg>
                    </div>
                </div>

                <div class="form-group">
                    <label>Birthday</label>
                    <div class="input-wrapper">
                        <input type="date" @bind="userModel.Birthday" @bind:format="yyyy-MM-dd" class="dark-input" />
                        <svg class="input-icon" viewBox="0 0 24 24"><path d="M19,19H5V8H19M16,1V3H8V1H6V3H5C3.89,3 3,3.89 3,5V19A2,2 0 0,0 5,21H19A2,2 0 0,0 21,19V5C21,3.89 20.1,3 19,3H18V1M17,12H12V17H17V12Z" /></svg>
                    </div>
                </div>

                <div class="form-group">
                    <label>Language</label>
                    <div class="select-wrapper">
                        <select @bind="userModel.Language" class="dark-select">
                            <option value="English">English</option>
                            <option value="Spanish">Spanish</option>
                        </select>
                        <span class="select-arrow">▼</span>
                    </div>
                </div>
            </div>

            <div class="preferences-column">
                <div class="preferences-box">

                    <div class="preferences-header">
                        <h2>PREFERENCES</h2>
                        <button class="btn-add" @onclick="OpenPreferenceModal" title="Add preference">＋</button>
                    </div>

                    <div class="preferences-list">
                        @foreach (var pref in userModel.Preferences)
                        {
                            <div class="preference-item" @key="pref">
                                <span>@pref</span>
                                <button class="btn-remove" @onclick="() => RemovePreference(pref)">✕</button>
                            </div>
                        }
                    </div>

                </div>

                <div class="settings-actions">
                    <button class="btn-action btn-themes" @onclick="OpenThemeModal">
                        <svg class="btn-svg" viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,0 2,12A10,10 0 0,0 12,22A1.5,1.5 0 0,0 13.5,20.5A1.5,1.5 0 0,0 13,19.4L13.1,19.3C13.3,19.1 13.6,19 14,19H16A5,5 0 0,0 21,14C21,9.24 16.96,5 12,5A1,1 0 0,0 11,6A1,1 0 0,0 12,7A3,3 0 0,1 15,10A1,1 0 0,0 16,11H17A2,2 0 0,1 19,13A2,2 0 0,1 17,15H14C12.34,15 11,13.66 11,12A4,4 0 0,1 15,8A1,1 0 0,0 15,6C15,4.34 13.66,3 12,3A8,8 0 0,0 4,11A8,8 0 0,0 12,19A1,1 0 0,0 13,18A1,1 0 0,0 12,17A6,6 0 0,1 6,11A6,6 0 0,1 12,5Z" /></svg>
                        Themes
                    </button>
                </div>
            </div>

        </div>
    </div>
}

<!-- Sticky save bar for mobile -->
<div class="sticky-save">
    <button class="btn-action btn-logout" @onclick="HandleLogout">Logout</button>
    <button class="btn-action btn-apply" @onclick="SaveChanges">Apply Changes</button>
</div>

@if (isThemeModalOpen)
{
    <div class="modal-overlay" @onclick="CloseThemeModal">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>SELECT THEME</h3>
                <button class="modal-close" @onclick="CloseThemeModal">✕</button>
            </div>
            <div class="modal-buttons-grid">
                <button class="theme-btn-option opt-light" @onclick='() => SelectTheme("light")'>Light</button>
                <button class="theme-btn-option opt-dark" @onclick='() => SelectTheme("dark")'>Dark</button>
                <button class="theme-btn-option opt-retro" @onclick='() => SelectTheme("retro")'>Retro</button>
                <button class="theme-btn-option opt-office" @onclick='() => SelectTheme("office")'>Office</button>
            </div>
        </div>
    </div>
}

@if (isPrefModalOpen)
{
    <div class="modal-overlay" @onclick="ClosePreferenceModal">
        <div class="modal-card" @onclick:stopPropagation>
            <div class="modal-header">
                <h3>ADD PREFERENCE</h3>
                <button class="modal-close" @onclick="ClosePreferenceModal">✕</button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>What are you interested in?</label>
                    <div class="input-wrapper">
                        <input type="text"
                               @bind="newPreferenceInput"
                               @bind:event="oninput"
                               @onkeyup="HandlePrefKeyUp"
                               class="dark-input"
                               placeholder="e.g. Artificial Intelligence"
                               maxlength="30" />
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(validationMessage))
                {
                    <div class="error-banner">
                        <svg viewBox="0 0 24 24" class="error-icon-svg"><path d="M13 14H11V9H13M13 18H11V16H13M12 2A10 10 0 0 0 2 12A10 10 0 0 0 12 22A10 10 0 0 0 22 12A10 10 0 0 0 12 2Z" /></svg>
                        <span>@validationMessage</span>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button class="btn-action btn-apply" @onclick="SavePreference">
                    Add Preference
                </button>
            </div>
        </div>
    </div>
}

@code {
    private SettingsFields userModel = new();

    // Modal and input state
    private bool isThemeModalOpen = false;
    private bool isPrefModalOpen = false;
    private string newPreferenceInput = "";
    private string validationMessage = "";

    private bool isSaving = false;
    private bool isLoggingOut = false;

    // Basic blocklist of disallowed words
    private readonly HashSet<string> blocklist = new(StringComparer.OrdinalIgnoreCase)
    {
        "mierda", "puto", "puta", "carajo", "pelotudo", "boludo", "concha", "forro", "culiao"
    };

    private bool userLoaded = false;
    private string saveMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await sessionService.InitializeAsync();
        if (!sessionService.IsAuthenticated || !sessionService.UserId.HasValue)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        if (!userLoaded)
        {
            var user = await authService.GetUserByIdAsync(sessionService.UserId.Value);
            if (user == null)
            {
                Navigation.NavigateTo("/login", true);
                return;
            }

            userModel.Email = user.Email;
            userModel.Username = user.Username;
            userModel.Birthday = user.Birthday ?? DateTime.Today;
            userModel.Password = string.Empty;
            userModel.Language = user.Language == 2 ? "Spanish" : "English";
            userModel.Preferences = await authService.GetUserPreferencesAsync(sessionService.UserId.Value);

            userLoaded = true;
            StateHasChanged();
        }
    }

    private void OpenThemeModal() => isThemeModalOpen = true;
    private void CloseThemeModal() => isThemeModalOpen = false;

    private async Task SelectTheme(string theme)
    {
        await JSRuntime.InvokeVoidAsync("localStorage.setItem", "selectedTheme", theme);
        ThemeState.SetTheme(theme);
        isThemeModalOpen = false;
    }

    // Preference modal logic
    private void OpenPreferenceModal()
    {
        newPreferenceInput = "";
        validationMessage = "";
        isPrefModalOpen = true;
    }

    private void ClosePreferenceModal() => isPrefModalOpen = false;

    private void SavePreference()
    {
        if (string.IsNullOrWhiteSpace(newPreferenceInput))
        {
            validationMessage = "The preference cannot be empty.";
            return;
        }

        string cleanInput = newPreferenceInput.Trim();

        // Prevent duplicates
        if (userModel.Preferences.Any(p => p.Equals(cleanInput, StringComparison.OrdinalIgnoreCase)))
        {
            validationMessage = "This preference already exists.";
            return;
        }

        // Check blocklist for disallowed words
        foreach (var badWord in blocklist)
        {
            if (cleanInput.Contains(badWord, StringComparison.OrdinalIgnoreCase))
            {
                validationMessage = "Explicit language or insults are not allowed.";
                return;
            }
        }

        // If the input is valid, add and close the modal
        userModel.Preferences.Add(cleanInput);
        isPrefModalOpen = false;
    }

    // Allow saving by pressing Enter in the input
    private void HandlePrefKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            SavePreference();
        }
    }

    private async Task SaveChanges()
    {
        saveMessage = string.Empty;
        if (!sessionService.UserId.HasValue)
        {
            saveMessage = "Authenticated user not found.";
            return;
        }

        isSaving = true;
        try
        {
            var updatedPassword = string.IsNullOrWhiteSpace(userModel.Password) ? null : userModel.Password;

            var success = await authService.ActualizarPerfilAsync(
                sessionService.UserId.Value,
                userModel.Username,
                userModel.Email,
                userModel.Birthday,
                userModel.Language == "English" ? "1" : "2",
                updatedPassword);

            var prefSuccess = await authService.ReplacePreferencesForUserAsync(sessionService.UserId.Value, userModel.Preferences);
            if (success && prefSuccess)
            {
                await sessionService.SetUserAsync(sessionService.UserId.Value, userModel.Username);
                saveMessage = "Profile updated successfully.";
            }
            else
            {
                saveMessage = "Could not save profile.";
            }
        }
        catch (Exception ex)
        {
            saveMessage = "Error saving: " + ex.Message;
        }
        finally
        {
            isSaving = false;
            StateHasChanged();
        }
    }

    private void RemovePreference(string target) => userModel.Preferences.Remove(target);

    private async Task HandleLogout()
    {
        if (isLoggingOut) return;
        isLoggingOut = true;
        try
        {
            // Clear client session and navigate to login
            await sessionService.ClearAsync();
            Navigation.NavigateTo("/login", true);
        }
        finally
        {
            isLoggingOut = false;
        }
    }

    public class SettingsFields
    {
        public string Email { get; set; } = "";
        public string Username { get; set; } = "";
        public string Password { get; set; } = "";
        public DateTime Birthday { get; set; }
        public string Language { get; set; } = "";
        public List<string> Preferences { get; set; } = new();
    }
}