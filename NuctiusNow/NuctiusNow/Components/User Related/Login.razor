@page "/login"
@using NuctiusNow.Services
@rendermode InteractiveServer
@inject AuthService authService
@inject NavigationManager Navigation
@inject UserSessionService sessionService
@inject EmailVerificationService EmailVerification

<PageTitle>Login - NuctiusNow</PageTitle>

<div class="login-page-container">

    <div class="login-card">
        <div class="login-header">
            <h1>LOGIN</h1>
            <p class="login-subtitle">Welcome back to NuctiusNow portal</p>
        </div>

        <div class="login-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <span class="error-text">@errorMessage</span>
                </div>
            }

            <EditForm Model="@loginModel" OnValidSubmit="HandleLogin">

                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" @bind-value="loginModel.Username" autocomplete="off" placeholder="example" />
                </div>

                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" @bind-value="loginModel.Password" placeholder="••••••••" />
                </div>

                <div class="form-checkbox">
                    <label class="checkbox-container">
                        <input type="checkbox" @bind="loginModel.RememberMe" />
                        <span class="custom-checkmark"></span>
                        <span class="checkbox-label">Remember my account info next time</span>
                    </label>
                </div>

                <button type="submit" class="btn-go">Go</button>

                <div class="register-redirect">
                    Don't have an account? <NavLink href="register">Register here</NavLink>
                </div>
            </EditForm>
        </div>
    </div>

</div>

@code {
    private LoginFields loginModel = new();
    private string errorMessage = string.Empty;

    private async Task HandleLogin()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(loginModel.Username) || string.IsNullOrWhiteSpace(loginModel.Password))
        {
            errorMessage = "Please provide both username and password.";
            return;
        }

        var (user, message) = await authService.LoginAsync(loginModel.Username, loginModel.Password);
        if (user == null)
        {
            errorMessage = message;
            return;
        }

        await sessionService.SetUserAsync(user.IdUser, loginModel.RememberMe);
        Navigation.NavigateTo("/");
    }

    public class LoginFields
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        await sessionService.InitializeAsync();
        if (sessionService.IsAuthenticated)
        {
            Navigation.NavigateTo("/", true);
        }
    }
}
