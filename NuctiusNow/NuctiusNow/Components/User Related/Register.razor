@page "/register"
@using NuctiusNow.Services
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject AuthService authService
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject EmailVerificationService EmailVerification

<PageTitle>Register - NuctiusNow</PageTitle>

<div class="register-page-container">

    <div class="register-card">
        <div class="register-header">
            <h1>REGISTER</h1>
            <p class="register-subtitle">Join NuctiusNow premium portal</p>
        </div>

        <div class="register-body">
            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="error-alert">
                    <span class="error-icon">⚠️</span>
                    <span class="error-text">@errorMessage</span>
                </div>
            }

            @if (!showPreferences)
            {
                <EditForm Model="@registerModel" OnValidSubmit="HandleRegister">

                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" @bind-value="registerModel.Email" autocomplete="off" placeholder="name@example.com" />
                    </div>

                    <div class="form-group">
                        <label for="username">Username</label>
                        <input type="text" id="username" @bind-value="registerModel.Username" autocomplete="off" placeholder="example" />
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input type="password" id="password" @bind-value="registerModel.Password" @bind-value:event="oninput" placeholder="••••••••" />

                        @if (!string.IsNullOrEmpty(registerModel.Password))
                        {
                            <div class="strength-meter-wrapper">
                                <div class="strength-bar-container">
                                    <div class="strength-bar" style="width: @(passwordStrengthScore * 25)%; background-color: @StrengthBarColor;"></div>
                                </div>
                                <span class="strength-text" style="color: @StrengthBarColor;">Strength: @passwordStrengthLabel</span>
                            </div>
                        }
                    </div>

                    <div class="form-group">
                        <label for="re-password">Confirm Password</label>
                        <input type="password" id="re-password" @bind-value="registerModel.ConfirmPassword" placeholder="••••••••" />
                    </div>

                    <div class="form-group">
                        <label>Security Check</label>
                        <div id="register-recaptcha-container"></div>
                    </div>

                    <div class="captcha-v3-disclaimer">
                        This site is protected by reCAPTCHA and the Google
                        <a href="https://policies.google.com/privacy" target="_blank">Privacy Policy</a> and
                        <a href="https://policies.google.com/terms" target="_blank">Terms of Service</a> apply.
                    </div>

                    <button type="submit" class="btn-create">Create Account</button>

                    <div class="login-redirect">
                        Already have an account? <NavLink href="login">Login here</NavLink>
                    </div>

                </EditForm>
            }
            else
            {
                <div class="preferences-setup">
                    <div class="activation-notice">
                        <span class="activation-notice-icon">✉</span>
                        <div>
                            <strong>Check your email before accessing NuctiusNow</strong>
                            <p>We sent an activation link to <b>@registerModel.Email</b>. Activate your account first. Your preferences can be saved now and will be ready when you sign in.</p>
                        </div>
                    </div>

                    <h3>Select your preferences</h3>
                    <p>Add topics you're interested in so we can personalize your feed.</p>

                    <div class="pref-input-row">
                        <input type="text" @bind="newPrefInput" placeholder="e.g. Technology" />
                        <button class="btn-add" @onclick="AddPreference">Add</button>
                    </div>

                    <div class="pref-list">
                        @foreach (var p in preferences)
                        {
                            <span class="pref-chip">@p <button class="chip-remove" @onclick="() => RemovePreference(p)">✕</button></span>
                        }
                    </div>

                    <div class="pref-actions">
                        <button class="btn-create" @onclick="SavePreferencesAsync">Save Preferences & Continue</button>
                    </div>
                </div>
            }
        </div>
    </div>

</div>

@code {
    private RegisterFields registerModel = new();
    private string errorMessage = string.Empty;

    private string RecaptchaSiteKey => Configuration["Recaptcha:SiteKey"] ?? string.Empty;

    // Registration -> Preferences flow state
    private bool showPreferences = false;
    private int? createdUserId = null;
    private List<string> preferences = new();
    private string newPrefInput = string.Empty;

    private int passwordStrengthScore => CalculatePasswordStrength(registerModel.Password);
    private string passwordStrengthLabel => GetStrengthLabel(passwordStrengthScore);
    private string StrengthBarColor => GetStrengthColor(passwordStrengthScore);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !string.IsNullOrWhiteSpace(RecaptchaSiteKey))
        {
            try
            {
                await JS.InvokeVoidAsync("renderRecaptchaCheckbox", "register-recaptcha-container", RecaptchaSiteKey);
            }
            catch (Exception ex)
            {
                Console.WriteLine($"reCAPTCHA render error: {ex.Message}");
            }
        }
    }

    private async Task HandleRegister()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(registerModel.Email) || !registerModel.Email.Contains("@"))
        {
            errorMessage = "The email address must contain an '@'.";
            return;
        }

        if (string.IsNullOrWhiteSpace(registerModel.Password) || registerModel.Password.Length < 8)
        {
            errorMessage = "The password must be at least 8 characters long.";
            return;
        }

        if (registerModel.Password != registerModel.ConfirmPassword)
        {
            errorMessage = "Passwords do not match.";
            return;
        }

        try
        {
            string recaptchaToken = await JS.InvokeAsync<string>("getRecaptchaToken");

            if (string.IsNullOrEmpty(recaptchaToken))
            {
                errorMessage = "Please complete the captcha to create an account.";
                await JS.InvokeVoidAsync("resetRecaptchaCheckbox");
                return;
            }

            var user = new User { Email = registerModel.Email, Username = registerModel.Username };
            var result = await authService.RegistrarConCaptchaAsync(user, registerModel.Password, recaptchaToken);
            if (!result.success)
            {
                errorMessage = result.message;
                await JS.InvokeVoidAsync("resetRecaptchaCheckbox");
                return;
            }

            if (!result.userId.HasValue)
            {
                errorMessage = "Registration did not return a user ID.";
                return;
            }
            createdUserId = result.userId;

            try
            {
                await EmailVerification.SendActivationEmailAsync(createdUserId.Value);
            }
            catch (Exception emailEx)
            {
                errorMessage = "Your account was created, but the activation email could not be sent. Configure SMTP and use the resend option on the verification page.";
                Console.WriteLine($"Activation email error: {emailEx.Message}");
            }

            showPreferences = true;
        }
        catch (Exception ex)
        {
            errorMessage = "Error validating Security Captcha. Make sure the script is loaded.";
            Console.WriteLine(ex.Message);
        }
    }

    private void AddPreference()
    {
        var clean = (newPrefInput ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(clean)) return;
        if (!preferences.Contains(clean, StringComparer.OrdinalIgnoreCase))
        {
            preferences.Add(clean);
        }
        newPrefInput = string.Empty;
    }

    private void RemovePreference(string p)
    {
        preferences.Remove(p);
    }

    private async Task SavePreferencesAsync()
    {
        errorMessage = string.Empty;
        if (!createdUserId.HasValue)
        {
            errorMessage = "User session missing. Please register again.";
            return;
        }

        var result = await authService.SavePreferencesForUserAsync(createdUserId.Value, preferences);
        if (!result.success)
        {
            errorMessage = result.message;
            return;
        }

        Navigation.NavigateTo(
            $"/email-verification-pending?email={Uri.EscapeDataString(registerModel.Email.Trim())}");
    }

    private int CalculatePasswordStrength(string password)
    {
        if (string.IsNullOrEmpty(password)) return 0;
        int score = 0;
        if (password.Length >= 8) score++;
        if (password.Any(char.IsDigit)) score++;
        if (password.Any(char.IsUpper) && password.Any(char.IsLower)) score++;
        if (password.Any(ch => !char.IsLetterOrDigit(ch))) score++;
        return score;
    }

    private string GetStrengthLabel(int score) => score switch
    {
        1 => "Weak 🔴",
        2 => "Medium 🟡",
        3 => "Good 🔵",
        4 => "Strong 🔥",
        _ => "Too Short ❌"
    };

    private string GetStrengthColor(int score) => score switch
    {
        1 => "#ef4444",
        2 => "#f59e0b",
        3 => "#3b82f6",
        4 => "#22c55e",
        _ => "#9ca3af"
    };

    public class RegisterFields
    {
        public string Email { get; set; } = string.Empty;
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public string ConfirmPassword { get; set; } = string.Empty;
    }
}